<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utils="clr-namespace:Nebula.Utilities">

    <utils:InverseBoolToVisibilityConverter x:Key="InverseBoolVis" />
    <utils:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <utils:EmptyStringToVisibilityConverter x:Key="EmptyStringCollapsed" />
    <BooleanToVisibilityConverter x:Key="BoolVis" />

    <!-- Palette defaults; replaced at runtime by ThemeEngine. -->
    <SolidColorBrush x:Key="C.Bg" Color="#0B0A14" />
    <SolidColorBrush x:Key="C.BgColor" Color="#0B0A14" />
    <SolidColorBrush x:Key="C.Panel" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="C.Card" Color="#0CFFFFFF" />
    <SolidColorBrush x:Key="C.CardHover" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="C.Stroke" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="C.StrokeSoft" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="C.Text" Color="#F6F4FF" />
    <Color x:Key="C.TextColor">#FFF6F4FF</Color>
    <SolidColorBrush x:Key="C.TextMuted" Color="#A9A4C7" />
    <SolidColorBrush x:Key="C.TextFaint" Color="#7A7694" />
    <SolidColorBrush x:Key="C.Accent" Color="#8B5CF6" />
    <SolidColorBrush x:Key="C.AccentText" Color="#A78BFA" />
    <SolidColorBrush x:Key="C.Accent2" Color="#22D3EE" />
    <Color x:Key="C.AccentColor">#FF8B5CF6</Color>
    <Color x:Key="C.Accent2Color">#FF22D3EE</Color>
    <LinearGradientBrush x:Key="C.AccentGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8B5CF6" Offset="0" />
        <GradientStop Color="#22D3EE" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="C.AccentSoft" Color="#2E8B5CF6" />
    <SolidColorBrush x:Key="C.AccentFaint" Color="#168B5CF6" />
    <SolidColorBrush x:Key="C.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="C.Track" Color="#28FFFFFF" />
    <SolidColorBrush x:Key="C.NavActive" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="C.Hover" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="C.Selected" Color="#348B5CF6" />
    <SolidColorBrush x:Key="C.Success" Color="#34D399" />
    <SolidColorBrush x:Key="C.Warn" Color="#FBBF24" />
    <SolidColorBrush x:Key="C.Danger" Color="#FB7185" />
    <SolidColorBrush x:Key="C.TooltipBg" Color="#1A1626" />
    <SolidColorBrush x:Key="C.Knob" Color="#F5F6FF" />
    <SolidColorBrush x:Key="C.Shadow" Color="#78000000" />
    <SolidColorBrush x:Key="C.WallpaperTint" Color="#20000000" />

    <!-- Surface-specific resources; ThemeEngine replaces these live for the three presets. -->
    <SolidColorBrush x:Key="S.CardBg" Color="#1A1626" />
    <SolidColorBrush x:Key="S.CardBorder" Color="#348B5CF6" />
    <SolidColorBrush x:Key="S.InnerBg" Color="#0CFFFFFF" />
    <SolidColorBrush x:Key="S.InnerBorder" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="S.Dim" Color="#9E070810" />
    <SolidColorBrush x:Key="S.Sheen" Color="#18FFFFFF" />
    <CornerRadius x:Key="S.CardRadius">22</CornerRadius>
    <CornerRadius x:Key="S.InnerRadius">14</CornerRadius>
    <CornerRadius x:Key="S.ResultRadius">11</CornerRadius>
    <CornerRadius x:Key="S.ControlRadius">10</CornerRadius>
    <CornerRadius x:Key="S.TrackRadius">2</CornerRadius>
    <Thickness x:Key="S.CardPadding">20</Thickness>
    <Thickness x:Key="S.ResultPadding">11,8,11,8</Thickness>
    <Thickness x:Key="S.BorderThickness">1</Thickness>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="S.TrackHeight">4</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="S.KnobSize">17</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="S.KnobHoverSize">19</sys:Double>
    <FontFamily x:Key="S.FontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="S.DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontWeight x:Key="S.TitleWeight">SemiBold</FontWeight>

    <LinearGradientBrush x:Key="C.DockGlass" StartPoint="0,0" EndPoint="0.3,1">
        <GradientStop Color="#CC2B1B52" Offset="0" />
        <GradientStop Color="#E60A0617" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="C.DockStroke" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#969F8CFF" Offset="0" />
        <GradientStop Color="#3C8B5CF6" Offset="0.55" />
        <GradientStop Color="#249F8CFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="C.ItemHover" Color="#1AFFFFFF" />

    <DrawingBrush x:Key="GrainBrush" TileMode="Tile" Viewport="0,0,5,5" ViewportUnits="Absolute"
                  Stretch="None" Opacity="0.5">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#0CFFFFFF" Geometry="M0,0 L1,0 L1,1 Z" />
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="24" ShadowDepth="6" Direction="270"
                      Opacity="0.35" Color="#000000" RenderingBias="Performance" />

    <Style x:Key="Row" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource C.StrokeSoft}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="0,0,0,12" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource C.Hover}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Margin" Value="0,0,8,8" />
    </Style>

    <!-- Typography -->
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="T.H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource S.DisplayFont}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource C.Text}" />
    </Style>

    <Style x:Key="T.H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource S.DisplayFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource C.Text}" />
    </Style>

    <Style x:Key="T.Section" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource C.TextMuted}" />
        <Setter Property="Margin" Value="2,0,0,10" />
    </Style>

    <Style x:Key="T.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource C.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="T.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource C.TextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="T.Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{DynamicResource C.TextMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Cards -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource C.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource C.StrokeSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <!-- Buttons -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource C.TextMuted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource S.ControlRadius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource C.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource C.Text}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource C.AccentSoft}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Padding" Value="15,9" />
        <Setter Property="Foreground" Value="{DynamicResource C.Text}" />
        <Setter Property="Background" Value="{DynamicResource C.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource C.Stroke}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{DynamicResource S.BorderThickness}"
                            CornerRadius="{DynamicResource S.ControlRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource C.CardHover}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource C.Accent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource C.AccentSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Padding" Value="17,10" />
        <Setter Property="Foreground" Value="{DynamicResource C.OnAccent}" />
        <Setter Property="Background" Value="{DynamicResource C.Accent}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.75" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dock buttons -->
    <Style x:Key="DockAppButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource C.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" RenderTransformOrigin="0.5,1">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="ItemScale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border x:Name="HoverBg" CornerRadius="13" Background="{DynamicResource C.ItemHover}" Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverBg" Property="Opacity" Value="1" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ItemScale" Storyboard.TargetProperty="ScaleX"
                                                         To="1.13" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.4" EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ItemScale" Storyboard.TargetProperty="ScaleY"
                                                         To="1.13" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.4" EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ItemScale" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ItemScale" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HoverBg" Property="Opacity" Value="0.75" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DockIconButton" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource C.TextMuted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="9">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource C.ItemHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource C.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DockOrbButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="OrbScale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border CornerRadius="13" Background="{DynamicResource C.AccentGrad}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.55"
                                                  Color="{DynamicResource C.AccentColor}" />
                            </Border.Effect>
                        </Border>
                        <Border CornerRadius="12" Margin="0" Background="{DynamicResource S.Sheen}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="OrbScale" Storyboard.TargetProperty="ScaleX"
                                                         To="1.07" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.4" EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="OrbScale" Storyboard.TargetProperty="ScaleY"
                                                         To="1.07" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.4" EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="OrbScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="OrbScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.88" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Navigation -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource C.TextMuted}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" CornerRadius="11" Background="Transparent" Margin="0,1">
                        <Grid>
                            <Border x:Name="Accent" Width="3" Height="18" CornerRadius="2" Margin="0"
                                    HorizontalAlignment="Left" Background="{DynamicResource C.Accent}" Opacity="0" />
                            <StackPanel Orientation="Horizontal" Margin="15,9">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons"
                                           FontSize="15" Width="20" TextAlignment="Center" VerticalAlignment="Center" />
                                <ContentPresenter VerticalAlignment="Center" Margin="9,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource C.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource C.NavActive}" />
                            <Setter TargetName="Accent" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource C.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style cards -->
    <Style x:Key="AccentSwatch" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="0,0,9,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="Fill" Width="22" Height="22" Fill="{Binding Brush}" />
                        <Ellipse x:Name="Ring" Width="29" Height="29" Stroke="{DynamicResource C.Accent}"
                                 StrokeThickness="1.5" Opacity="0" />
                        <TextBlock x:Name="AutoLabel" Text="A" FontSize="9" FontWeight="SemiBold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsAuto}" Value="True">
                            <Setter TargetName="Fill" Property="Fill" Value="{DynamicResource C.AccentGrad}" />
                            <Setter TargetName="AutoLabel" Property="Opacity" Value="1" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StyleCard" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Card" CornerRadius="15" Background="{DynamicResource C.Card}"
                            BorderBrush="{DynamicResource C.StrokeSoft}" BorderThickness="1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource C.CardHover}" />
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource C.Stroke}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource C.Accent}" />
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource C.AccentFaint}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Switch -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Border x:Name="Track" CornerRadius="{DynamicResource S.ControlRadius}"
                                Background="{DynamicResource C.Track}" />
                        <Border x:Name="Thumb" Width="19" Height="19"
                                CornerRadius="{DynamicResource S.ResultRadius}"
                                HorizontalAlignment="Left" Margin="3.5,0,0,0" Background="{DynamicResource C.Knob}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ThumbShift" X="0" />
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.3" Color="#000000" />
                            </Border.Effect>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource C.AccentGrad}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbShift" Storyboard.TargetProperty="X"
                                                         To="20" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbShift" Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider -->
    <Style x:Key="SlimSlider" TargetType="Slider">
        <Setter Property="Height" Value="26" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" Background="Transparent">
                        <Border Height="{DynamicResource S.TrackHeight}"
                                CornerRadius="{DynamicResource S.TrackRadius}"
                                Background="{DynamicResource C.Track}" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="{DynamicResource S.TrackHeight}"
                                                    CornerRadius="{DynamicResource S.TrackRadius}"
                                                    Background="{DynamicResource C.AccentGrad}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="{DynamicResource S.KnobSize}" Height="{DynamicResource S.KnobSize}"
                                       Focusable="False" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Ellipse Fill="{DynamicResource C.AccentFaint}"
                                                         Width="{DynamicResource S.KnobSize}"
                                                         Height="{DynamicResource S.KnobSize}" />
                                                <Ellipse x:Name="Knob" Fill="{DynamicResource C.Knob}" Width="11" Height="11" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Knob" Property="Width" Value="{DynamicResource S.KnobHoverSize}" />
                                                    <Setter TargetName="Knob" Property="Height" Value="{DynamicResource S.KnobHoverSize}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="{DynamicResource S.TrackHeight}" Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text input -->
    <Style x:Key="Input" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource C.Hover}" />
        <Setter Property="Foreground" Value="{DynamicResource C.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource C.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource C.StrokeSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SelectionBrush" Value="{DynamicResource C.Accent}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource S.ControlRadius}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource C.Accent}" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource C.Card}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Progress -->
    <Style x:Key="MiniBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Background" Value="{DynamicResource C.Track}" />
        <Setter Property="Foreground" Value="{DynamicResource C.AccentGrad}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="2" Background="{TemplateBinding Background}"
                                Height="4" VerticalAlignment="Center" />
                        <Border x:Name="PART_Indicator" CornerRadius="2" Background="{TemplateBinding Foreground}"
                                Height="4" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Scrollbar -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent" Margin="2,0">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="3" Background="{DynamicResource C.Stroke}"
                                                    Margin="1,2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Monitor picker -->
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource C.Text}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="ComboBorder"
                                            Background="{DynamicResource C.Hover}"
                                            BorderBrush="{DynamicResource C.StrokeSoft}"
                                            BorderThickness="1" CornerRadius="8">
                                        <Grid>
                                            <ContentPresenter Margin="10,0,26,0"
                                                              VerticalAlignment="Center"
                                                              Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                            <Path Data="M0,0 L5,5 L10,0"
                                                  Stroke="{DynamicResource C.TextMuted}" StrokeThickness="1.4"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,11,0" />
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Popup x:Name="PART_Popup" Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False"
                               PopupAnimation="Fade" StaysOpen="False">
                            <Border Background="{DynamicResource C.TooltipBg}"
                                    BorderBrush="{DynamicResource C.StrokeSoft}"
                                    BorderThickness="1" CornerRadius="10" Padding="5"
                                    Margin="0,4,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource C.Text}" />
        <Setter Property="Background" Value="{DynamicResource C.TooltipBg}" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBg" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBg" Property="Background" Value="{DynamicResource C.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBg" Property="Background" Value="{DynamicResource C.AccentSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tooltip -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource C.Text}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource C.TooltipBg}" BorderBrush="{DynamicResource C.Stroke}"
                            BorderThickness="1" CornerRadius="10" Padding="11,7" MaxWidth="340">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Context menu -->
    <Style TargetType="ContextMenu">
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource C.TooltipBg}" BorderBrush="{DynamicResource C.Stroke}"
                            BorderThickness="1" CornerRadius="12" Padding="5">
                        <StackPanel IsItemsHost="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource C.Text}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource C.Hover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- List results -->
    <Style x:Key="ResultItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="{DynamicResource S.ResultPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bg" CornerRadius="{DynamicResource S.ResultRadius}"
                            Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource C.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource C.AccentSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
