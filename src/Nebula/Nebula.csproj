<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 1809 target unlocks the WinRT media-session API used by
         the taskbar media widget; the desktop runtime is still .NET 8. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Nebula</RootNamespace>
    <AssemblyName>Nebula</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\nebula.ico</ApplicationIcon>
    <Product>Nebula Taskbar Studio</Product>
    <AssemblyTitle>Nebula</AssemblyTitle>
    <Version>1.7.5</Version>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>it;en</SatelliteResourceLanguages>
    <!-- WPF owns DPI awareness through app.manifest; WFAC010 is a WinForms-only suggestion. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!-- Injected by the GitHub release workflow; empty in a normal local build. -->
    <UpdateRepository Condition="'$(UpdateRepository)' == ''"></UpdateRepository>
  </PropertyGroup>

  <PropertyGroup>
    <WatchdogProject>..\Nebula.Watchdog\Nebula.Watchdog.csproj</WatchdogProject>
    <WatchdogTargetFramework>net8.0-windows</WatchdogTargetFramework>
    <WatchdogBuildDir>..\Nebula.Watchdog\bin\$(Configuration)\$(WatchdogTargetFramework)</WatchdogBuildDir>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Nebula.UpdateRepository</_Parameter1>
      <_Parameter2>$(UpdateRepository)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Builds and restores the watchdog; it is not referenced as an assembly. -->
    <ProjectReference Include="$(WatchdogProject)"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <!--
    Development builds get the watchdog next to the app too, so F5 and the
    framework-dependent publish stay complete.
  -->
  <Target Name="BuildTaskbarWatchdog" AfterTargets="Build" Condition="'$(RuntimeIdentifier)' == ''">
    <ItemGroup>
      <WatchdogFiles Include="$(WatchdogBuildDir)\Nebula.Watchdog.exe" />
      <WatchdogFiles Include="$(WatchdogBuildDir)\Nebula.Watchdog.dll" />
      <WatchdogFiles Include="$(WatchdogBuildDir)\Nebula.Watchdog.deps.json" />
      <WatchdogFiles Include="$(WatchdogBuildDir)\Nebula.Watchdog.runtimeconfig.json" />
    </ItemGroup>

    <Copy SourceFiles="@(WatchdogFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true"
          Condition="Exists('$(WatchdogBuildDir)\Nebula.Watchdog.exe')" />
  </Target>

  <!--
    A published app must not depend on a separately installed .NET runtime for
    its crash watchdog: if the watchdog cannot start, Nebula refuses to hide the
    native taskbar. Publishing it with the same RID and self-contained mode makes
    both executables use the runtime files that are already in the publish folder.
  -->
  <Target Name="PublishTaskbarWatchdog" AfterTargets="Publish">
    <PropertyGroup>
      <WatchdogStageDir>$(MSBuildProjectDirectory)\obj\watchdog-publish\$(Configuration)\</WatchdogStageDir>
    </PropertyGroup>

    <RemoveDir Directories="$(WatchdogStageDir)" />

    <MSBuild Projects="$(WatchdogProject)"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$(WatchdogStageDir);PublishSingleFile=false;PublishReadyToRun=false;DebugType=embedded" />

    <ItemGroup>
      <WatchdogPublishedFiles Include="$(WatchdogStageDir)Nebula.Watchdog.exe" />
      <WatchdogPublishedFiles Include="$(WatchdogStageDir)Nebula.Watchdog.dll" />
      <WatchdogPublishedFiles Include="$(WatchdogStageDir)Nebula.Watchdog.deps.json" />
      <WatchdogPublishedFiles Include="$(WatchdogStageDir)Nebula.Watchdog.runtimeconfig.json" />
    </ItemGroup>

    <Copy SourceFiles="@(WatchdogPublishedFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />

    <Error Condition="!Exists('$(PublishDir)Nebula.Watchdog.exe')"
           Text="Nebula.Watchdog.exe non è stato copiato in $(PublishDir): la sostituzione della taskbar non sarebbe sicura." />
    <Error Condition="!Exists('$(PublishDir)Nebula.Watchdog.runtimeconfig.json')"
           Text="Nebula.Watchdog.runtimeconfig.json non è stato copiato in $(PublishDir)." />
  </Target>

</Project>
