<UserControl x:Class="Nebula.Views.SystemIconsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Nebula.Views"
             FontFamily="Segoe UI Variable Text, Segoe UI">
    <StackPanel>
        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="ICONE DI SISTEMA" Style="{StaticResource T.Section}" />
                        <TextBlock Text="Applica la stessa arte a collegamenti, tipi file e cartelle del tuo profilo."
                                   Style="{StaticResource T.Caption}" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource Chip}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppliedText}" FontSize="10.5"
                                   Foreground="{DynamicResource C.TextMuted}" />
                    </Border>
                </Grid>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Stile" FontSize="11" Foreground="{DynamicResource C.TextMuted}"
                                   Margin="2,0,0,5" />
                        <ComboBox ItemsSource="{Binding StyleOptions}"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedStyle, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="SystemStyleBox">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Forma" FontSize="11" Foreground="{DynamicResource C.TextMuted}"
                                   Margin="2,0,0,5" />
                        <ComboBox ItemsSource="{Binding ShapeOptions}"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedShape, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="SystemShapeBox">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="Applica a tutte" Style="{StaticResource PrimaryButton}"
                                Padding="14,8" Click="OnApplyAll"
                                AutomationProperties.AutomationId="ApplySystemIcons" />
                        <Button Content="Ripristina originali" Style="{StaticResource GhostButton}"
                                Padding="13,8" Margin="8,0,0,0" Click="OnRestoreAll"
                                AutomationProperties.AutomationId="RestoreSystemIcons" />
                    </StackPanel>
                </Grid>

                <Border Background="{DynamicResource C.Hover}" CornerRadius="10" Padding="11,8"
                        Margin="0,13,0,0">
                    <TextBlock Text="Solo superfici per-utente: IconLocation dei collegamenti, HKCU\Software\Classes e desktop.ini delle cartelle utente. I binari di System32 e le chiavi HKLM non vengono toccati."
                               Style="{StaticResource T.Caption}" />
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="18,15,18,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="VOCI RILEVATE" Style="{StaticResource T.Section}" />
                        <TextBlock Text="{Binding CountText}" Style="{StaticResource T.Caption}" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Style="{StaticResource Input}" Height="32"
                             Margin="0,0,8,0"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Filtra per nome, cartella o tipo"
                             AutomationProperties.Name="Filtra icone"
                             AutomationProperties.AutomationId="SystemIconSearch" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding FilterOptions}"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedFilter, Mode=TwoWay}"
                              Height="32" AutomationProperties.AutomationId="SystemIconFilter">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <ListBox Grid.Row="1" x:Name="ItemsList" ItemsSource="{Binding Items}"
                         Background="Transparent" BorderThickness="0" MaxHeight="390"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         AutomationProperties.AutomationId="SystemIconList">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Padding" Value="18,8" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                            <Setter Property="AutomationProperties.HelpText" Value="{Binding Detail}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bg" Background="Transparent"
                                                BorderBrush="{DynamicResource C.StrokeSoft}"
                                                BorderThickness="0,0,0,1"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource C.Hover}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource C.AccentFaint}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="34" Height="34" CornerRadius="10"
                                        Background="{DynamicResource C.Hover}"
                                        BorderBrush="{DynamicResource C.StrokeSoft}" BorderThickness="1">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons"
                                               FontSize="15" Foreground="{DynamicResource C.TextMuted}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="6,0,10,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource C.Text}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="300" />
                                        <Border Background="{DynamicResource C.Hover}" CornerRadius="5"
                                                Padding="5,2" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Badge}" FontSize="8.5"
                                                       Foreground="{DynamicResource C.TextFaint}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Caption}"
                                               FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding StatusText}" FontSize="10.5"
                                               Foreground="{DynamicResource C.TextMuted}"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding SourceText}" FontSize="9"
                                               Foreground="{DynamicResource C.TextFaint}"
                                               HorizontalAlignment="Right" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{Binding ActionText}" Style="{StaticResource GhostButton}"
                                            Padding="10,6" FontSize="11"
                                            Tag="{Binding}" Click="OnPickItem"
                                            AutomationProperties.Name="Scegli icona" />
                                    <Button Content="Ripristina" Style="{StaticResource GhostButton}"
                                            Padding="9,6" FontSize="10.5" Margin="6,0,0,0"
                                            Tag="{Binding}" Click="OnRestoreItem"
                                            Visibility="{Binding IsApplied, Converter={StaticResource BoolVis}}"
                                            AutomationProperties.Name="Ripristina voce" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="BACKUP E RIPRISTINO" Style="{StaticResource T.Section}" />
                    <TextBlock Text="{Binding BackupText}" Style="{StaticResource T.Caption}" />
                    <TextBlock Text="Il journal viene scritto prima della prima modifica. Se Nebula viene chiusa forzatamente, al prossimo avvio ripristina le voci rimaste a metà."
                               Style="{StaticResource T.Caption}" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="Apri cartella backup"
                        Style="{StaticResource GhostButton}" Padding="11,7"
                        VerticalAlignment="Center" Click="OnOpenBackupFolder" />
            </Grid>
        </Border>

        <Border Background="{DynamicResource C.Hover}" CornerRadius="11" Padding="12,9">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="12"
                           Foreground="{DynamicResource C.AccentText}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource T.Caption}"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
