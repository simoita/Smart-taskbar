<Window x:Class="Nebula.Views.TabBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nebula Tabs"
        Width="640" Height="46" SizeToContent="Manual"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Grid x:Name="Root" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="BarSlide" Y="7" />
        </Grid.RenderTransform>

        <!-- La barra è il "cappello" della finestra attiva: copre la vecchia
             barra del titolo di Windows e offre schede, riduci, ingrandisci e
             chiudi, oltre al trascinamento e al ridimensionamento. -->
        <Border x:Name="Bar" Height="{Binding BarHeight}"
                CornerRadius="8,8,0,0"
                Background="{DynamicResource C.DockGlass}"
                BorderBrush="{DynamicResource C.DockStroke}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="OnBarMouseDown"
                MouseMove="OnBarMouseMove"
                MouseRightButtonUp="OnBarRightClick"
                MouseLeave="OnBarMouseLeave">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ScrollViewer x:Name="TabScroller"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Left"
                              Focusable="False"
                              PreviewMouseWheel="OnTabScrollerWheel">
                    <ItemsControl x:Name="TabItems" ItemsSource="{Binding Tabs}"
                                  Background="Transparent" Focusable="False"
                                  AllowDrop="True"
                                  Drop="OnTabDrop" DragOver="OnTabDragOver">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="TabRoot"
                                        Height="{Binding DataContext.ChipHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        MinWidth="120" MaxWidth="248"
                                        Margin="1,0" Padding="7,0,4,0"
                                        CornerRadius="7"
                                        Background="Transparent"
                                        Cursor="Hand"
                                        AutomationProperties.Name="{Binding Title}"
                                        PreviewMouseLeftButtonDown="OnTabMouseDown"
                                        PreviewMouseMove="OnTabMouseMove"
                                        MouseLeftButtonUp="OnTabMouseUp"
                                        MouseRightButtonUp="OnTabRightClick"
                                        AllowDrop="True"
                                        Drop="OnTabDrop" DragOver="OnTabDragOver">
                                    <Grid ClipToBounds="True">
                                        <Border x:Name="HoverBg" CornerRadius="7"
                                                Background="{DynamicResource C.Hover}" Opacity="0" />
                                        <Border x:Name="SelectionBg" CornerRadius="7"
                                                Background="{DynamicResource C.Selected}" Opacity="0" />
                                        <Border x:Name="AccentMark" Width="3"
                                                Height="{Binding DataContext.ChipMarkHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CornerRadius="2" HorizontalAlignment="Left"
                                                Background="{DynamicResource C.AccentGrad}" Opacity="0" />
                                        <Border x:Name="Underline" Height="2" Width="24"
                                                CornerRadius="1" VerticalAlignment="Bottom"
                                                Background="{DynamicResource C.AccentGrad}" Opacity="0" />

                                        <Grid Margin="1,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="{Binding DataContext.ChipIconSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Height="{Binding DataContext.ChipIconSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CornerRadius="5"
                                                    Background="{DynamicResource C.Hover}"
                                                    VerticalAlignment="Center">
                                                <Image Source="{Binding Icon}" Width="14" Height="14"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>

                                            <TextBlock x:Name="TabTitle" Grid.Column="1"
                                                       Text="{Binding Title}"
                                                       Margin="6,0,4,0" VerticalAlignment="Center"
                                                       FontSize="11" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource C.Text}" />

                                            <Button Grid.Column="2"
                                                    Width="{Binding DataContext.ChipCloseSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Height="{Binding DataContext.ChipCloseSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Style="{StaticResource IconButton}"
                                                    Padding="0" Focusable="False"
                                                    ToolTip="Chiudi finestra"
                                                    Click="OnCloseTabClick"
                                                    Tag="{Binding}">
                                                <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons"
                                                           FontSize="8" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="SelectionBg" Property="Opacity" Value="1" />
                                        <Setter TargetName="AccentMark" Property="Opacity" Value="1" />
                                        <Setter TargetName="Underline" Property="Opacity" Value="1" />
                                        <Setter TargetName="TabTitle" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <Trigger SourceName="TabRoot" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="HoverBg" Property="Opacity" Value="1" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding StyleKey}" Value="minimal">
                                        <Setter TargetName="TabRoot" Property="CornerRadius" Value="4" />
                                        <Setter TargetName="HoverBg" Property="CornerRadius" Value="4" />
                                        <Setter TargetName="SelectionBg" Property="CornerRadius" Value="4" />
                                        <Setter TargetName="SelectionBg" Property="Background" Value="{DynamicResource C.Hover}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StyleKey}" Value="neon">
                                        <Setter TargetName="TabRoot" Property="CornerRadius" Value="10" />
                                        <Setter TargetName="HoverBg" Property="CornerRadius" Value="10" />
                                        <Setter TargetName="SelectionBg" Property="CornerRadius" Value="10" />
                                        <Setter TargetName="SelectionBg" Property="Background" Value="{DynamicResource C.Accent}" />
                                        <Setter TargetName="AccentMark" Property="Opacity" Value="0" />
                                        <Setter TargetName="Underline" Property="Opacity" Value="0" />
                                        <Setter TargetName="TabTitle" Property="Foreground" Value="{DynamicResource C.OnAccent}" />
                                        <Setter TargetName="TabTitle" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StyleKey}" Value="glass">
                                        <Setter TargetName="SelectionBg" Property="Opacity" Value="1" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StyleKey}" Value="liquid">
                                        <Setter TargetName="TabRoot" Property="CornerRadius" Value="10" />
                                        <Setter TargetName="HoverBg" Property="CornerRadius" Value="10" />
                                        <Setter TargetName="SelectionBg" Property="CornerRadius" Value="10" />
                                        <Setter TargetName="SelectionBg" Property="Background" Value="{DynamicResource C.Selected}" />
                                        <Setter TargetName="TabTitle" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch"
                            Margin="4,0,4,0">
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}"
                            Width="38" Height="{Binding BarHeight}"
                            ToolTip="Riduci a icona" Click="OnMinimizeWindow"
                            AutomationProperties.Name="Riduci a icona">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons" FontSize="9" />
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}"
                            Width="38" Height="{Binding BarHeight}"
                            ToolTip="Ingrandisci" Click="OnMaximizeWindow"
                            AutomationProperties.Name="Ingrandisci">
                        <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;"
                                   FontFamily="Segoe Fluent Icons" FontSize="9" />
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}"
                            Width="38" Height="{Binding BarHeight}"
                            ToolTip="Chiudi finestra" Click="OnCloseWindow"
                            AutomationProperties.Name="Chiudi finestra">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="9" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
