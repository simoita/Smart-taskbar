<Window x:Class="Nebula.Views.TabBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nebula Tabs"
        SizeToContent="WidthAndHeight" MaxWidth="1200"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Grid x:Name="Root" Margin="14" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="BarSlide" Y="7" />
        </Grid.RenderTransform>

        <Border x:Name="Bar" Height="{Binding BarHeight}"
                CornerRadius="14" Background="{DynamicResource C.DockGlass}"
                BorderBrush="{DynamicResource C.DockStroke}" BorderThickness="1"
                Padding="5,4">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="7" Direction="270"
                                  Opacity="0.45" Color="#000000" RenderingBias="Performance" />
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              MaxWidth="980" Focusable="False">
                    <ItemsControl x:Name="TabItems" ItemsSource="{Binding Tabs}"
                                  AllowDrop="True" Focusable="False"
                                  Drop="OnTabDrop" DragOver="OnTabDragOver">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="TabRoot"
                                        Height="34" MinWidth="132" MaxWidth="248"
                                        Margin="2,0" Padding="8,0,5,0"
                                        CornerRadius="11"
                                        Background="Transparent"
                                        Cursor="Hand"
                                        AutomationProperties.Name="{Binding Title}"
                                        PreviewMouseLeftButtonDown="OnTabMouseDown"
                                        PreviewMouseMove="OnTabMouseMove"
                                        MouseLeftButtonUp="OnTabMouseUp"
                                        MouseRightButtonUp="OnTabRightClick"
                                        AllowDrop="True"
                                        Drop="OnTabDrop" DragOver="OnTabDragOver">
                                    <Grid ClipToBounds="True">
                                        <Border x:Name="HoverBg" CornerRadius="11"
                                                Background="{DynamicResource C.Hover}" Opacity="0" />
                                        <Border x:Name="SelectionBg" CornerRadius="11"
                                                Background="{DynamicResource C.Selected}" Opacity="0" />
                                        <Border x:Name="AccentMark" Width="3" Height="18"
                                                CornerRadius="2" HorizontalAlignment="Left"
                                                Margin="0,0,0,0" VerticalAlignment="Center"
                                                Background="{DynamicResource C.AccentGrad}" Opacity="0" />
                                        <Border x:Name="Underline" Height="2" Width="24"
                                                CornerRadius="1" VerticalAlignment="Bottom"
                                                Background="{DynamicResource C.AccentGrad}" Opacity="0" />

                                        <Grid Margin="1,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="22" Height="22" CornerRadius="6"
                                                    Background="{DynamicResource C.Hover}"
                                                    VerticalAlignment="Center">
                                                <Image Source="{Binding Icon}" Width="16" Height="16"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>

                                            <TextBlock x:Name="TabTitle" Grid.Column="1"
                                                       Text="{Binding Title}"
                                                       Margin="7,0,5,0" VerticalAlignment="Center"
                                                       FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource C.Text}" />

                                            <Button Grid.Column="2" Width="20" Height="20"
                                                    Style="{StaticResource IconButton}"
                                                    Padding="0" Focusable="False"
                                                    ToolTip="Chiudi finestra"
                                                    Click="OnCloseTabClick"
                                                    Tag="{Binding}">
                                                <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons"
                                                           FontSize="8" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="SelectionBg" Property="Opacity" Value="1" />
                                        <Setter TargetName="AccentMark" Property="Opacity" Value="1" />
                                        <Setter TargetName="Underline" Property="Opacity" Value="1" />
                                        <Setter TargetName="TabTitle" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <Trigger SourceName="TabRoot" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="HoverBg" Property="Opacity" Value="1" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding StyleKey}" Value="minimal">
                                        <Setter TargetName="TabRoot" Property="CornerRadius" Value="4" />
                                        <Setter TargetName="TabRoot" Property="Margin" Value="1,0" />
                                        <Setter TargetName="HoverBg" Property="CornerRadius" Value="4" />
                                        <Setter TargetName="SelectionBg" Property="CornerRadius" Value="4" />
                                        <Setter TargetName="SelectionBg" Property="Background" Value="{DynamicResource C.Hover}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StyleKey}" Value="neon">
                                        <Setter TargetName="TabRoot" Property="CornerRadius" Value="17" />
                                        <Setter TargetName="TabRoot" Property="Margin" Value="3,0" />
                                        <Setter TargetName="HoverBg" Property="CornerRadius" Value="17" />
                                        <Setter TargetName="SelectionBg" Property="CornerRadius" Value="17" />
                                        <Setter TargetName="SelectionBg" Property="Background" Value="{DynamicResource C.Accent}" />
                                        <Setter TargetName="AccentMark" Property="Opacity" Value="0" />
                                        <Setter TargetName="Underline" Property="Opacity" Value="0" />
                                        <Setter TargetName="TabTitle" Property="Foreground" Value="{DynamicResource C.OnAccent}" />
                                        <Setter TargetName="TabTitle" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StyleKey}" Value="glass">
                                        <Setter TargetName="SelectionBg" Property="Opacity" Value="1" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StyleKey}" Value="liquid">
                                        <Setter TargetName="TabRoot" Property="CornerRadius" Value="18" />
                                        <Setter TargetName="TabRoot" Property="Margin" Value="3,0" />
                                        <Setter TargetName="HoverBg" Property="CornerRadius" Value="18" />
                                        <Setter TargetName="SelectionBg" Property="CornerRadius" Value="18" />
                                        <Setter TargetName="SelectionBg" Property="Background" Value="{DynamicResource C.Selected}" />
                                        <Setter TargetName="TabTitle" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Button Grid.Column="1" Width="30" Height="30" Margin="5,0,0,0"
                        Style="{StaticResource IconButton}"
                        ToolTip="Chiudi gruppo e ripristina tutte le finestre"
                        Click="OnCloseGroupClick">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
