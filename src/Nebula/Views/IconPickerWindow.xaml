<Window x:Class="Nebula.Views.IconPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scegli icona di sistema"
        Width="820" Height="680" MinWidth="720" MinHeight="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Border Background="{DynamicResource C.Bg}" BorderBrush="{DynamicResource C.Stroke}"
            BorderThickness="1" CornerRadius="20" Margin="18">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel>
                    <TextBlock Text="Scegli icona" Style="{StaticResource T.H1}" FontSize="24" />
                    <TextBlock x:Name="TargetText" Text="Icona di sistema"
                               Style="{StaticResource T.Caption}" Margin="0,5,0,0" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Width="30" Height="30"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        ToolTip="Chiudi" Click="OnCancelClick">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="10" />
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="0,20,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="214" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="ANTEPRIMA" Style="{StaticResource T.Section}" />
                        <Border Height="150" CornerRadius="16" Background="{DynamicResource C.Hover}">
                            <Image x:Name="LargePreview" Width="112" Height="112"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="SourceText" Text="Icona originale"
                                   Style="{StaticResource T.Caption}" Margin="0,12,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Content="Carica un'icona…" Style="{StaticResource GhostButton}"
                                Padding="12,7" HorizontalAlignment="Left" Margin="0,12,0,0"
                                AutomationProperties.AutomationId="LoadCustomIcon"
                                Click="OnLoadCustomClick" />
                        <TextBlock x:Name="CustomText" Text=""
                                   Style="{StaticResource T.Caption}" Margin="0,7,0,0"
                                   Foreground="{DynamicResource C.AccentText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="STILE" Style="{StaticResource T.Section}" />
                    <ListBox x:Name="StyleList" Height="176" Background="Transparent"
                             BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionChanged="OnStyleChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Margin" Value="0,0,7,7" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bg" CornerRadius="11"
                                                    Background="{DynamicResource C.Card}"
                                                    BorderBrush="{DynamicResource C.StrokeSoft}"
                                                    BorderThickness="1" Padding="8,7">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource C.CardHover}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource C.Accent}" />
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource C.AccentFaint}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="9"
                                            Background="{DynamicResource C.Hover}">
                                        <Image Source="{Binding Preview}" Width="30" Height="30"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource C.Text}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="9.5"
                                                   Foreground="{DynamicResource C.TextMuted}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="210" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Forma della piastra" FontSize="12"
                                   Foreground="{DynamicResource C.TextMuted}"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="ShapeBox" Grid.Column="1" Height="34"
                                  AutomationProperties.Name="Forma icona"
                                  SelectionChanged="OnShapeChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Border Style="{StaticResource Card}" Padding="13" Margin="0,14,0,0"
                            Background="{DynamicResource C.Hover}">
                        <TextBlock Text="Le varianti 16–256 px vengono generate su disco. Explorer sceglie la misura giusta senza scalare un'unica immagine."
                                   Style="{StaticResource T.Caption}" />
                    </Border>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="ANTEPRIMA SU MISURE REALI" Style="{StaticResource T.Section}" />
                    <WrapPanel x:Name="SizePreviewPanel" Height="70" />
                    <TextBlock Text="Le icone vengono applicate solo al tuo profilo. Nessun file in System32 e nessuna chiave HKLM vengono modificati."
                               Style="{StaticResource T.Caption}" Margin="2,10,0,0" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="3" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Scegli uno stile o carica un'icona."
                           Style="{StaticResource T.Caption}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Annulla" Style="{StaticResource GhostButton}"
                            Padding="15,8" Click="OnCancelClick" />
                    <Button x:Name="ApplyButton" Content="Applica icona"
                            Style="{StaticResource PrimaryButton}"
                            Padding="16,8" Margin="8,0,0,0"
                            AutomationProperties.AutomationId="ApplyIcon"
                            Click="OnApplyClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
