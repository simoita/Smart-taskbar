<Window x:Class="Nebula.Views.GroupPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Raggruppa finestre in schede"
        Width="620" Height="570" MinWidth="520" MinHeight="430"
        WindowStyle="SingleBorderWindow" AllowsTransparency="False"
        Background="{DynamicResource C.Bg}"
        ShowInTaskbar="True" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Border Background="{DynamicResource C.Bg}" BorderBrush="{DynamicResource C.Stroke}"
            BorderThickness="1" CornerRadius="18" Margin="18">

        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Background="Transparent" MouseLeftButtonDown="OnHeaderDrag" Cursor="SizeAll"
                  ToolTip="Trascina per spostare la finestra">
                <StackPanel>
                    <TextBlock Text="Raggruppa finestre" Style="{StaticResource T.H1}"
                               FontSize="23" />
                    <TextBlock Text="Scegli almeno due finestre. Nebula creerà una tab bar ancorata al gruppo."
                               Style="{StaticResource T.Caption}" Margin="0,5,0,0" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Width="30" Height="30"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        ToolTip="Chiudi" Click="OnCancelClick">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="10" />
                </Button>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,10" Margin="0,18,0,10"
                    Background="{DynamicResource C.Hover}">
                <TextBlock Text="Le finestre protette, elevate o UWP non compaiono: Nebula non può controllarle in sicurezza."
                           Style="{StaticResource T.Caption}" />
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="WindowItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource C.StrokeSoft}"
                                    BorderThickness="0,0,0,1" Padding="8,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="34" Height="34" CornerRadius="9"
                                            Background="{DynamicResource C.Hover}"
                                            VerticalAlignment="Center">
                                        <Image Source="{Binding Candidate.Icon}" Width="22" Height="22"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="11,0,12,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Candidate.Title}" FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource C.Text}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Candidate.ProcessName}" FontSize="10.5"
                                                   Foreground="{DynamicResource C.TextMuted}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <CheckBox Grid.Column="2" Style="{StaticResource Switch}"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="{Binding Candidate.Title}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText"
                           Text="Seleziona almeno due finestre."
                           Style="{StaticResource T.Caption}" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Annulla" Style="{StaticResource GhostButton}"
                            Padding="15,8" Click="OnCancelClick" />
                    <Button x:Name="GroupButton" Content="Crea gruppo"
                            Style="{StaticResource PrimaryButton}"
                            Padding="16,8" Margin="8,0,0,0"
                            IsEnabled="False" Click="OnGroupClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
