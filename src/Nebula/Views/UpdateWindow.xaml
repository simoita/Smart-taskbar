<Window x:Class="Nebula.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aggiornamento Nebula"
        Width="500" SizeToContent="Height"
        WindowStyle="SingleBorderWindow" AllowsTransparency="False"
        Background="{DynamicResource C.Bg}"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Border Background="{DynamicResource C.Bg}"
            BorderBrush="{DynamicResource C.Stroke}"
            BorderThickness="1" CornerRadius="18" Margin="18">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel>
                    <TextBlock Text="Aggiornamento disponibile"
                               Style="{StaticResource T.H1}" FontSize="23" />
                    <TextBlock x:Name="VersionText"
                               Style="{StaticResource T.Caption}" Margin="0,5,0,0" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Width="30" Height="30"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        ToolTip="Più tardi" Click="OnLaterClick">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="10" />
                </Button>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,12" Margin="0,18,0,0"
                    Background="{DynamicResource C.Hover}">
                <StackPanel>
                    <TextBlock x:Name="CurrentText" Style="{StaticResource T.Caption}" />
                    <ScrollViewer x:Name="NotesPanel" MaxHeight="118" Margin="0,8,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="NotesText" Style="{StaticResource T.Caption}"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,14,0,0">
                <TextBlock x:Name="StatusText"
                           Text="Nebula scarica il pacchetto, verifica lo SHA-256, si chiude e si riapre con la nuova versione."
                           Style="{StaticResource T.Caption}"
                           TextWrapping="Wrap" />

                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,10,0,0">
                    <ProgressBar x:Name="DownloadProgressBar" Style="{StaticResource DownloadBar}"
                                 Minimum="0" Maximum="100" Value="0"
                                 AutomationProperties.Name="Avanzamento del download" />
                    <Grid Margin="0,7,0,0">
                        <TextBlock x:Name="ProgressText" Style="{StaticResource T.Caption}"
                                   AutomationProperties.AutomationId="UpdateProgressText" />
                        <TextBlock x:Name="ProgressPercent" Style="{StaticResource T.Caption}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,18,0,0">
                <Button x:Name="LaterButton" Content="Più tardi"
                        Style="{StaticResource GhostButton}" Padding="15,8"
                        Click="OnLaterClick" />
                <Button x:Name="InstallButton" Content="Aggiorna e riavvia"
                        Style="{StaticResource PrimaryButton}" Padding="16,8"
                        Margin="8,0,0,0" Click="OnInstallClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
