                                                    <Grid>
                                                        <StackPanel MaxWidth="500" HorizontalAlignment="Left">
                                                            <TextBlock Text="Dock in alto" FontSize="13"
                                                                       Foreground="{DynamicResource C.Text}" />
                                                            <TextBlock Text="Sposta la barra sul bordo superiore dello schermo."
                                                                       Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <CheckBox Style="{StaticResource Switch}"
                                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                  IsChecked="{Binding Settings.DockOnTop, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <StackPanel MaxWidth="500" HorizontalAlignment="Left">
                                                            <TextBlock Text="Schermo della dock" FontSize="13"
                                                                       Foreground="{DynamicResource C.Text}" />
                                                            <TextBlock Text="La dock si centra sullo schermo scelto, rispettandone DPI e area di lavoro."
                                                                       Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <ComboBox Width="226" Height="32"
                                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                  ItemsSource="{Binding Screens}"
                                                                  SelectedValuePath="Index"
                                                                  SelectedValue="{Binding Settings.MonitorIndex, Mode=TwoWay}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding DisplayName}" />
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <StackPanel MaxWidth="500" HorizontalAlignment="Left">
                                                            <TextBlock Text="Nascondi automaticamente" FontSize="13"
                                                                       Foreground="{DynamicResource C.Text}" />
                                                            <TextBlock Text="La dock si ritrae e riappare quando tocchi il bordo."
                                                                       Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <CheckBox Style="{StaticResource Switch}"
                                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                  IsChecked="{Binding Settings.AutoHideDock, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <StackPanel>
                                                            <TextBlock Text="Distanza dal bordo" FontSize="13"
                                                                       Foreground="{DynamicResource C.Text}" />
                                                            <Slider Style="{StaticResource SlimSlider}" Minimum="0"
                                                                    Maximum="48" Value="{Binding Settings.EdgeMargin, Mode=TwoWay}"
                                                                    Margin="0,8,120,0" />
                                                        </StackPanel>
                                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                   Text="{Binding Settings.EdgeMargin, StringFormat='{}{0:0} px'}"
                                                                   FontSize="12" Foreground="{DynamicResource C.TextMuted}" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource Row}" BorderThickness="0" Padding="0" Margin="0">
                                                    <Grid>
                                                        <StackPanel MaxWidth="500" HorizontalAlignment="Left">
                                                            <TextBlock Text="Nascondi in schermo intero" FontSize="13"
                                                                       Foreground="{DynamicResource C.Text}" />
                                                            <TextBlock Text="Giochi e video restano puliti: la dock riappare quando esci."
                                                                       Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <CheckBox Style="{StaticResource Switch}"
                                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                  IsChecked="{Binding Settings.HideInFullscreen, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                                            <StackPanel>
                                                <TextBlock Text="INTEGRAZIONE CON WINDOWS" Style="{StaticResource T.Section}" />
                                                <Border Style="{StaticResource Row}" BorderThickness="0" Padding="0" Margin="0">
                                                    <Grid>
                                                        <StackPanel MaxWidth="520">
                                                            <TextBlock Text="Sostituisci la taskbar di Windows" FontSize="13"
                                                                       Foreground="{DynamicResource C.Text}" />
                                                            <TextBlock Text="Nasconde la taskbar originale mentre Nebula è attiva. Un watchdog la ripristina anche se Nebula viene terminata forzatamente."
                                                                       Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <CheckBox Style="{StaticResource Switch}"
                                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                  IsChecked="{Binding Settings.ReplaceWindowsTaskbar, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                                            <StackPanel>
                                                <TextBlock Text="ZONE DELLA DOCK" Style="{StaticResource T.Section}" />
