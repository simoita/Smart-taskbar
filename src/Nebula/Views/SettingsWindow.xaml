<Window x:Class="Nebula.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Nebula.Views"
        Title="Nebula Taskbar Studio" Width="1120" Height="740"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Grid Margin="24">
        <Border CornerRadius="20" Background="#000000" Margin="0,12,0,0" Opacity="0.65">
            <Border.Effect>
                <DropShadowEffect BlurRadius="42" ShadowDepth="16" Direction="270" Opacity="0.55"
                                  Color="#000000" RenderingBias="Performance" />
            </Border.Effect>
        </Border>

        <Border x:Name="Chrome" CornerRadius="20" Background="{DynamicResource C.Bg}"
                BorderBrush="{DynamicResource C.Stroke}" BorderThickness="1"
                SizeChanged="OnChromeSizeChanged" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="WindowScale" ScaleX="0.985" ScaleY="0.985" />
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent"
                      MouseLeftButtonDown="OnTitleBarDrag">
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="7"
                                Background="{DynamicResource C.AccentGrad}">
                            <UniformGrid Rows="2" Columns="2" Width="11" Height="11">
                                <Ellipse Width="3" Height="3" Fill="{DynamicResource C.OnAccent}" Margin="1" />
                                <Ellipse Width="3" Height="3" Fill="{DynamicResource C.OnAccent}" Margin="1" />
                                <Ellipse Width="3" Height="3" Fill="{DynamicResource C.OnAccent}" Margin="1" />
                                <Ellipse Width="3" Height="3" Fill="{DynamicResource C.OnAccent}" Margin="1" />
                            </UniformGrid>
                        </Border>
                        <TextBlock Text="Nebula" FontSize="13" FontWeight="SemiBold" Margin="9,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource C.Text}" />
                        <TextBlock Text="Taskbar Studio" FontSize="10.5" Margin="7,1,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource C.TextMuted}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Width="30" Height="30"
                                Click="OnMinimize" ToolTip="Riduci a icona">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons" FontSize="10" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="30" Height="30"
                                Click="OnClose" ToolTip="Chiudi">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="10" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="232" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Navigation rail -->
                    <Border Background="{DynamicResource C.Panel}"
                            BorderBrush="{DynamicResource C.StrokeSoft}" BorderThickness="0,1,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Margin="13,16,13,0">
                                <TextBlock Text="PERSONALIZZA" Style="{StaticResource T.Section}"
                                           Margin="12,0,0,10" />

                                <RadioButton x:Name="NavStyle" Style="{StaticResource NavItem}" Uid="style"
                                             Tag="&#xE790;" Content="Stile" GroupName="NebulaNav"
                                             Checked="OnNavChecked" />
                                <RadioButton Style="{StaticResource NavItem}" Uid="dock" Tag="&#xE700;"
                                             Content="Dock" GroupName="NebulaNav" Checked="OnNavChecked" />
                                <RadioButton Style="{StaticResource NavItem}" Uid="icons" Tag="&#xE71B;"
                                             Content="Icone" GroupName="NebulaNav" Checked="OnNavChecked" />
                                <RadioButton Style="{StaticResource NavItem}" Uid="tabs" Tag="&#xE7C4;"
                                             Content="Schede" GroupName="NebulaNav" Checked="OnNavChecked" />
                                <RadioButton Style="{StaticResource NavItem}" Uid="widgets" Tag="&#xE787;"
                                             Content="Widget" GroupName="NebulaNav" Checked="OnNavChecked" />
                                <RadioButton Style="{StaticResource NavItem}" Uid="search" Tag="&#xE721;"
                                             Content="Ricerca" GroupName="NebulaNav" Checked="OnNavChecked" />
                                <RadioButton Style="{StaticResource NavItem}" Uid="controls" Tag="&#xE9E9;"
                                             Content="Controlli" GroupName="NebulaNav" Checked="OnNavChecked" />
                                <RadioButton Style="{StaticResource NavItem}" Uid="motion" Tag="&#xE768;"
                                             Content="Animazioni" GroupName="NebulaNav" Checked="OnNavChecked" />
                                <RadioButton Style="{StaticResource NavItem}" Uid="behavior" Tag="&#xE713;"
                                             Content="Comportamento" GroupName="NebulaNav" Checked="OnNavChecked" />
                                <RadioButton Style="{StaticResource NavItem}" Uid="info" Tag="&#xE946;"
                                             Content="Info" GroupName="NebulaNav" Checked="OnNavChecked" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Margin="22,0,22,18">
                                <Border Height="1" Background="{DynamicResource C.StrokeSoft}" Margin="0,0,0,14" />
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource C.Success}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="Salvataggio automatico" FontSize="10" Margin="7,0,0,0"
                                               Foreground="{DynamicResource C.TextMuted}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding Version, StringFormat='Nebula {0}'}" FontSize="9.5" Margin="0,6,0,0"
                                           Foreground="{DynamicResource C.TextFaint}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Pages -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="34,24,34,12">
                            <TextBlock x:Name="PageTitle" Style="{StaticResource T.H1}" Text="Stile" />
                            <TextBlock x:Name="PageSubtitle" Style="{StaticResource T.Caption}" Margin="0,4,0,0"
                                       Text="Scegli un'identità visiva, poi rifinisci vetro, forma e accento." />
                        </StackPanel>

                        <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      Padding="34,0,24,26" HorizontalScrollBarVisibility="Disabled">
                            <Grid x:Name="PageHost">

                                <!-- STILE -->
                                <Grid x:Name="PageStyle" VerticalAlignment="Top">
                                    <StackPanel>
                                        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,22">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel>
                                                    <TextBlock Text="ANTEPRIMA LIVE" Style="{StaticResource T.Section}" />

                                                    <Border Height="84" CornerRadius="22"
                                                            Background="{Binding Preview.TintBrush}"
                                                            BorderBrush="{Binding Preview.StrokeBrush}"
                                                            BorderThickness="1" Padding="12,0" ClipToBounds="True">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Width="38" Height="38" CornerRadius="12"
                                                                    Background="{DynamicResource C.AccentGrad}">
                                                                <UniformGrid Rows="2" Columns="2" Width="14" Height="14">
                                                                    <Ellipse Width="4" Height="4" Fill="{DynamicResource C.OnAccent}" Margin="1.2" />
                                                                    <Ellipse Width="4" Height="4" Fill="{DynamicResource C.OnAccent}" Margin="1.2" />
                                                                    <Ellipse Width="4" Height="4" Fill="{DynamicResource C.OnAccent}" Margin="1.2" />
                                                                    <Ellipse Width="4" Height="4" Fill="{DynamicResource C.OnAccent}" Margin="1.2" />
                                                                </UniformGrid>
                                                            </Border>

                                                            <Border Width="1" Height="26" Margin="9,0,7,0"
                                                                    Background="{DynamicResource C.StrokeSoft}" />

                                                            <ItemsControl ItemsSource="{Binding Preview.Items}"
                                                                          VerticalAlignment="Center" MaxWidth="250"
                                                                          ClipToBounds="True">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Width="34" Height="34" Margin="2,0"
                                                                                CornerRadius="9"
                                                                                Background="{DynamicResource C.ItemHover}">
                                                                            <Image Source="{Binding Icon}" Width="21" Height="21"
                                                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <Border Width="1" Height="26" Margin="8,0,10,0"
                                                                    Background="{DynamicResource C.StrokeSoft}" />
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Preview.TimeText}" FontSize="15"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource C.Text}"
                                                                           Typography.NumeralAlignment="Tabular" />
                                                                <TextBlock Text="{Binding Preview.DateText}" FontSize="9.5"
                                                                           Foreground="{DynamicResource C.TextMuted}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <TextBlock Text="Ogni modifica è immediata: la dock si aggiorna mentre trascini i controlli."
                                                               Style="{StaticResource T.Caption}" Margin="2,10,0,0" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Margin="24,0,0,0" Width="180"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="STILE ATTIVO" Style="{StaticResource T.Section}" />
                                                    <TextBlock Text="{Binding ActiveThemeName}" Style="{StaticResource T.H2}"
                                                               Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding ActiveThemeTagline}"
                                                               Style="{StaticResource T.Caption}" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="PRESET" Style="{StaticResource T.Section}" Margin="2,0,0,10" />
                                        <ItemsControl ItemsSource="{Binding StyleCards}" Margin="0,0,0,14">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <RadioButton GroupName="NebulaStyleCards"
                                                                 Style="{StaticResource StyleCard}"
                                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                 Margin="0,0,10,10" Click="OnStyleCardClick">
                                                        <StackPanel>
                                                            <Border Height="58" CornerRadius="12,12,6,6"
                                                                    Margin="5,5,5,0" Background="{Binding Preview}">
                                                                <Grid>
                                                                    <Border Height="16" Width="92" CornerRadius="8"
                                                                            Background="#30FFFFFF"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center" />
                                                                    <Border Height="16" Width="34" CornerRadius="8"
                                                                            Background="{Binding Accent}" Opacity="0.75"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Border>
                                                            <StackPanel Margin="11,8,11,10">
                                                                <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource C.Text}" />
                                                                <TextBlock Text="{Binding Tagline}" FontSize="9.5"
                                                                           Foreground="{DynamicResource C.TextMuted}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </RadioButton>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border Style="{StaticResource Card}" Margin="0,0,0,22">
                                            <StackPanel>
                                                <TextBlock Text="PRESET SUPERFICI" Style="{StaticResource T.Section}" />
                                                <TextBlock Text="Vetro, Minimal, Neon, Soft e Mono applicati dal vivo a widget, controlli rapidi e ricerca. Le schede mantengono il proprio stile."
                                                           Style="{StaticResource T.Caption}" Margin="0,0,0,12" TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Vetro" Style="{StaticResource GhostButton}"
                                                            Tag="glass" Padding="16,8" Margin="0,0,8,0"
                                                            Click="OnSurfaceStyleClick"
                                                            AutomationProperties.Name="Preset superfici Vetro" />
                                                    <Button Content="Minimal" Style="{StaticResource GhostButton}"
                                                            Tag="minimal" Padding="16,8" Margin="0,0,8,0"
                                                            Click="OnSurfaceStyleClick"
                                                            AutomationProperties.Name="Preset superfici Minimal" />
                                                    <Button Content="Neon" Style="{StaticResource GhostButton}"
                                                            Tag="neon" Padding="16,8"
                                                            Click="OnSurfaceStyleClick"
                                                            AutomationProperties.Name="Preset superfici Neon" />
                                                    <Button Content="Soft" Style="{StaticResource GhostButton}"
                                                            Tag="soft" Padding="16,8" Margin="8,0,0,0"
                                                            Click="OnSurfaceStyleClick"
                                                            AutomationProperties.Name="Preset superfici Soft" />
                                                    <Button Content="Mono" Style="{StaticResource GhostButton}"
                                                            Tag="mono" Padding="16,8" Margin="8,0,0,0"
                                                            Click="OnSurfaceStyleClick"
                                                            AutomationProperties.Name="Preset superfici Mono" />
                                                    <TextBlock VerticalAlignment="Center" Margin="14,0,0,0"
                                                               FontSize="10.5" Foreground="{DynamicResource C.TextMuted}"
                                                               Text="{Binding ActiveSurfaceStyleName, StringFormat='Attivo: {0}'}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}" Margin="0,0,0,22">
                                            <StackPanel>
                                                <TextBlock Text="ICONE" Style="{StaticResource T.Section}" />
                                                <TextBlock Text="Stile, forma e dimensione delle icone nella dock e nelle superfici. Le icone scelte qui si adattano al riquadro e alla forma richiesta; i collegamenti del desktop possono ricevere un'icona .ico o .exe personale."
                                                           Style="{StaticResource T.Caption}" Margin="0,0,0,10" TextWrapping="Wrap" />
                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <TextBlock Text="Stile delle icone" FontSize="13" Foreground="{DynamicResource C.Text}"
                                                                   VerticalAlignment="Center" />
                                                        <ComboBox Width="226" Height="32" HorizontalAlignment="Right"
                                                                  ItemsSource="{Binding IconStyleOptions}"
                                                                  SelectedValuePath="Id"
                                                                  SelectedValue="{Binding Settings.IconStyle, Mode=TwoWay}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <TextBlock Text="Forma delle icone" FontSize="13" Foreground="{DynamicResource C.Text}"
                                                                   VerticalAlignment="Center" />
                                                        <ComboBox Width="226" Height="32" HorizontalAlignment="Right"
                                                                  ItemsSource="{Binding IconShapeOptions}"
                                                                  SelectedValuePath="Id"
                                                                  SelectedValue="{Binding Settings.IconShape, Mode=TwoWay}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="ICONE DELLE APP FISSATE" Style="{StaticResource T.Section}" Margin="0,8,0,6" />
                                                <ItemsControl ItemsSource="{Binding Pins}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource Row}">
                                                                <Grid>
                                                                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource C.Text}"
                                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="460" />
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                        <ComboBox Width="176" Height="28"
                                                                                  ItemsSource="{Binding DataContext.PerIconStyleOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                  SelectedValuePath="Id"
                                                                                  SelectedValue="{Binding SelectedStyle, Mode=TwoWay}">
                                                                            <ComboBox.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                                </DataTemplate>
                                                                            </ComboBox.ItemTemplate>
                                                                        </ComboBox>
                                                                        <Button Content="Scegli icona…" Style="{StaticResource GhostButton}"
                                                                                Padding="10,5" Margin="6,0,0,0"
                                                                                Tag="{Binding Path}" Click="OnPickDockIcon" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="COLLEGAMENTI DEL DESKTOP" Style="{StaticResource T.Section}" Margin="0,8,0,6" />
                                                <TextBlock Text="Modifica l'icona del collegamento originale: Windows la mostra sul desktop e nel menu Start. Non vengono toccati gli eseguibili di sistema."
                                                           Style="{StaticResource T.Caption}" Margin="0,0,0,7" TextWrapping="Wrap" />
                                                <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding DesktopShortcuts}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Style="{StaticResource Row}">
                                                                    <Grid>
                                                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource C.Text}"
                                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="460" />
                                                                        <Button Content="Cambia icona…" Style="{StaticResource GhostButton}"
                                                                                Padding="10,5" HorizontalAlignment="Right"
                                                                                Tag="{Binding Path}" Click="OnPickShortcutIcon" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                                <TextBlock Text="{Binding PinStatus}" Style="{StaticResource T.Caption}"
                                                           Margin="0,8,0,0" Foreground="{DynamicResource C.Success}" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}" Margin="0,0,0,22">
                                            <StackPanel>
                                                <TextBlock Text="ACCENTO" Style="{StaticResource T.Section}" />
                                                <ItemsControl ItemsSource="{Binding Accents}" Margin="0,2,0,12">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource AccentSwatch}"
                                                                    Click="OnAccentClick" ToolTip="{Binding Hex}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Hex" FontSize="11.5" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource C.TextMuted}"
                                                               Margin="0,0,10,0" />
                                                    <TextBox x:Name="AccentBox" Style="{StaticResource Input}"
                                                             Width="140" FontSize="12"
                                                             Text="{Binding AccentInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             KeyDown="OnAccentKeyDown" />
                                                    <Button Content="Applica" Style="{StaticResource GhostButton}"
                                                            Padding="13,8" Margin="8,0,0,0" Click="OnApplyAccent" />
                                                    <TextBlock Text="{Binding ActiveThemeName, StringFormat='Preset: {0}'}"
                                                               VerticalAlignment="Center" Margin="16,0,0,0"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource C.TextFaint}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}" Margin="0,0,0,22">
                                            <StackPanel>
                                                <TextBlock Text="SUPERFICIE" Style="{StaticResource T.Section}" />

                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="Trasparenza del vetro" FontSize="13"
                                                                       Foreground="{DynamicResource C.Text}" />
                                                            <Slider Style="{StaticResource SlimSlider}" Minimum="0.3"
                                                                    Maximum="1" Value="{Binding Settings.GlassOpacity, Mode=TwoWay}"
                                                                    Margin="0,8,24,0" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                                   Text="{Binding Settings.GlassOpacity, StringFormat='{}{0:P0}'}"
                                                                   FontSize="12" Foreground="{DynamicResource C.TextMuted}" />
                                                    </Grid>
                                                </Border>

                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="Raggio degli angoli" FontSize="13"
                                                                       Foreground="{DynamicResource C.Text}" />
                                                            <Slider Style="{StaticResource SlimSlider}" Minimum="4"
                                                                    Maximum="36" Value="{Binding Settings.CornerRadius, Mode=TwoWay}"
                                                                    Margin="0,8,24,0" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                                   Text="{Binding Settings.CornerRadius, StringFormat='{}{0:0} px'}"
                                                                   FontSize="12" Foreground="{DynamicResource C.TextMuted}" />
                                                    </Grid>
                                                </Border>

                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="Altezza della dock" FontSize="13"
                                                                       Foreground="{DynamicResource C.Text}" />
                                                            <Slider Style="{StaticResource SlimSlider}" Minimum="44"
                                                                    Maximum="92" Value="{Binding Settings.DockHeight, Mode=TwoWay}"
                                                                    Margin="0,8,24,0" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                                   Text="{Binding Settings.DockHeight, StringFormat='{}{0:0} px'}"
                                                                   FontSize="12" Foreground="{DynamicResource C.TextMuted}" />
                                                    </Grid>
                                                </Border>

                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="Dimensione icone" FontSize="13"
                                                                       Foreground="{DynamicResource C.Text}" />
                                                            <Slider Style="{StaticResource SlimSlider}" Minimum="16"
                                                                    Maximum="44" Value="{Binding Settings.IconSize, Mode=TwoWay}"
                                                                    Margin="0,8,24,0" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                                   Text="{Binding Settings.IconSize, StringFormat='{}{0:0} px'}"
                                                                   FontSize="12" Foreground="{DynamicResource C.TextMuted}" />
                                                    </Grid>
                                                </Border>

                                                <Border Style="{StaticResource Row}" BorderThickness="0" Padding="0" Margin="0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="Spaziatura tra le icone" FontSize="13"
                                                                       Foreground="{DynamicResource C.Text}" />
                                                            <Slider Style="{StaticResource SlimSlider}" Minimum="-4"
                                                                    Maximum="12" Value="{Binding Settings.ItemSpacing, Mode=TwoWay}"
                                                                    Margin="0,8,24,0" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                                   Text="{Binding Settings.ItemSpacing, StringFormat='{}{0:0.0}'}"
                                                                   FontSize="12" Foreground="{DynamicResource C.TextMuted}" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="DETTAGLI" Style="{StaticResource T.Section}" />
                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <StackPanel MaxWidth="500" HorizontalAlignment="Left">
                                                            <TextBlock Text="Bagliori d'accento" FontSize="13"
                                                                       Foreground="{DynamicResource C.Text}" />
                                                            <TextBlock Text="Aggiunge luce del colore accento ai lati della dock."
                                                                       Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <CheckBox Style="{StaticResource Switch}"
                                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                  IsChecked="{Binding Settings.ShowGlow, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <StackPanel MaxWidth="500" HorizontalAlignment="Left">
                                                            <TextBlock Text="Grana del vetro" FontSize="13"
                                                                       Foreground="{DynamicResource C.Text}" />
