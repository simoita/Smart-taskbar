                                                           Style="{StaticResource T.Caption}" Margin="0,0,0,10" TextWrapping="Wrap" />
                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <TextBlock Text="Zona icone e avvio" FontSize="13" Foreground="{DynamicResource C.Text}"
                                                                   VerticalAlignment="Center" />
                                                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                  AutomationProperties.Name="Zona icone e avvio"
                                                                  IsChecked="{Binding Settings.DockAppsZone, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <TextBlock Text="Zona sistema e orologio" FontSize="13" Foreground="{DynamicResource C.Text}"
                                                                   VerticalAlignment="Center" />
                                                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                  AutomationProperties.Name="Zona sistema e orologio"
                                                                  IsChecked="{Binding Settings.DockSystemZone, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <TextBlock Text="Zona azioni e ricerca" FontSize="13" Foreground="{DynamicResource C.Text}"
                                                                   VerticalAlignment="Center" />
                                                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                  AutomationProperties.Name="Zona azioni e ricerca"
                                                                  IsChecked="{Binding Settings.DockActionsZone, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <TextBlock Text="Ordine delle zone" FontSize="13" Foreground="{DynamicResource C.Text}"
                                                                   VerticalAlignment="Center" />
                                                        <ComboBox Width="226" Height="32" HorizontalAlignment="Right"
                                                                  ItemsSource="{Binding ZoneOrderOptions}"
                                                                  SelectedValuePath="Id"
                                                                  SelectedValue="{Binding Settings.DockZoneOrder, Mode=TwoWay}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <TextBlock Text="Distanza tra le zone" FontSize="13" Foreground="{DynamicResource C.Text}"
                                                                   Margin="0,0,0,8" />
                                                        <TextBlock Text="{Binding Settings.DockZoneSpacing, StringFormat='{}{0:0} px'}"
                                                                   HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource C.TextMuted}" />
                                                        <Slider Style="{StaticResource SlimSlider}" Minimum="0" Maximum="24"
                                                                Margin="0,22,0,0" Value="{Binding Settings.DockZoneSpacing, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource Row}" BorderThickness="0" Padding="0" Margin="0">
                                                    <Grid>
                                                        <TextBlock Text="Separatori tra le zone" FontSize="13" Foreground="{DynamicResource C.Text}"
                                                                   VerticalAlignment="Center" />
                                                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                  AutomationProperties.Name="Separatori tra le zone"
                                                                  IsChecked="{Binding Settings.DockZoneDividers, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <TextBlock Text="Scala zona icone" FontSize="13" Foreground="{DynamicResource C.Text}"
                                                                   Margin="0,0,0,8" />
                                                        <TextBlock Text="{Binding Settings.DockAppsScale, StringFormat='{}{0:0.00}×'}"
                                                                   HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource C.TextMuted}" />
                                                        <Slider Style="{StaticResource SlimSlider}" Minimum="0.75" Maximum="1.3"
                                                                Margin="0,22,0,0" Value="{Binding Settings.DockAppsScale, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <TextBlock Text="Scala zona sistema" FontSize="13" Foreground="{DynamicResource C.Text}"
                                                                   Margin="0,0,0,8" />
                                                        <TextBlock Text="{Binding Settings.DockSystemScale, StringFormat='{}{0:0.00}×'}"
                                                                   HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource C.TextMuted}" />
                                                        <Slider Style="{StaticResource SlimSlider}" Minimum="0.75" Maximum="1.3"
                                                                Margin="0,22,0,0" Value="{Binding Settings.DockSystemScale, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource Row}" BorderThickness="0" Padding="0" Margin="0">
                                                    <Grid>
                                                        <TextBlock Text="Scala zona azioni" FontSize="13" Foreground="{DynamicResource C.Text}"
                                                                   Margin="0,0,0,8" />
                                                        <TextBlock Text="{Binding Settings.DockActionsScale, StringFormat='{}{0:0.00}×'}"
                                                                   HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource C.TextMuted}" />
                                                        <Slider Style="{StaticResource SlimSlider}" Minimum="0.75" Maximum="1.3"
                                                                Margin="0,22,0,0" Value="{Binding Settings.DockActionsScale, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                                            <StackPanel>
                                                <TextBlock Text="STATO DELLE ICONE" Style="{StaticResource T.Section}" />
                                                <TextBlock Text="Scegli come appare un'app aperta, ridotta o chiusa: indicatore, forma e trasparenza."
                                                           Style="{StaticResource T.Caption}" Margin="0,0,0,10" TextWrapping="Wrap" />
                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <TextBlock Text="Indicatore app aperta" FontSize="13" Foreground="{DynamicResource C.Text}"
                                                                   VerticalAlignment="Center" />
                                                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                  IsChecked="{Binding Settings.ShowOpenIndicator, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <TextBlock Text="Indicatore finestra ridotta" FontSize="13" Foreground="{DynamicResource C.Text}"
                                                                   VerticalAlignment="Center" />
                                                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                  IsChecked="{Binding Settings.ShowMinimizedIndicator, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <TextBlock Text="Indicatore app chiusa" FontSize="13" Foreground="{DynamicResource C.Text}"
                                                                   VerticalAlignment="Center" />
                                                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                  IsChecked="{Binding Settings.ShowClosedIndicator, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <TextBlock Text="Forma dell'indicatore" FontSize="13" Foreground="{DynamicResource C.Text}"
                                                                   VerticalAlignment="Center" />
                                                        <ComboBox Width="226" Height="32" HorizontalAlignment="Right"
                                                                  ItemsSource="{Binding IndicatorStyleOptions}"
                                                                  SelectedValuePath="Id"
                                                                  SelectedValue="{Binding Settings.DockIndicatorStyle, Mode=TwoWay}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <TextBlock Text="Opacità icona ridotta" FontSize="13" Foreground="{DynamicResource C.Text}"
                                                                   Margin="0,0,0,8" />
                                                        <TextBlock Text="{Binding Settings.MinimizedIconOpacity, StringFormat='{}{0:P0}'}"
                                                                   HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource C.TextMuted}" />
                                                        <Slider Style="{StaticResource SlimSlider}" Minimum="0.2" Maximum="1"
                                                                Margin="0,22,0,0" Value="{Binding Settings.MinimizedIconOpacity, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource Row}" BorderThickness="0" Padding="0" Margin="0">
                                                    <Grid>
                                                        <TextBlock Text="Opacità app chiusa" FontSize="13" Foreground="{DynamicResource C.Text}"
                                                                   Margin="0,0,0,8" />
                                                        <TextBlock Text="{Binding Settings.ClosedIconOpacity, StringFormat='{}{0:P0}'}"
                                                                   HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource C.TextMuted}" />
                                                        <Slider Style="{StaticResource SlimSlider}" Minimum="0.2" Maximum="1"
                                                                Margin="0,22,0,0" Value="{Binding Settings.ClosedIconOpacity, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,12">
                                                    <StackPanel>
                                                        <TextBlock Text="APP FISSATE" Style="{StaticResource T.Section}"
                                                                   Margin="0" />
                                                        <TextBlock Text="Le app che vuoi sempre a portata di clic."
                                                                   Style="{StaticResource T.Caption}" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                                VerticalAlignment="Top">
                                                        <Button Content="Aggiungi app…" Style="{StaticResource PrimaryButton}"
                                                                Padding="13,7" Click="OnAddPin" />
                                                        <Button Content="Predefinite" Style="{StaticResource GhostButton}"
                                                                Padding="12,7" Margin="8,0,0,0" Click="OnResetPins" />
                                                    </StackPanel>
                                                </Grid>

                                                <ItemsControl ItemsSource="{Binding Pins}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{DynamicResource C.StrokeSoft}"
                                                                    BorderThickness="0,0,0,1" Padding="0,7">
                                                                <Grid>
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <Border Width="28" Height="28" CornerRadius="8"
                                                                                Background="{DynamicResource C.Hover}">
                                                                            <Image Source="{Binding Icon}" Width="19"
                                                                                   Height="19"
                                                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                                                        </Border>
                                                                        <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                                                                   Foreground="{DynamicResource C.Text}" />
                                                                    </StackPanel>
                                                                    <Button Style="{StaticResource IconButton}"
                                                                            Width="26" Height="26"
                                                                            HorizontalAlignment="Right"
                                                                            Tag="{Binding}" Click="OnRemovePinClick"
                                                                            ToolTip="Rimuovi">
                                                                        <TextBlock Text="&#xE711;"
                                                                                   FontFamily="Segoe Fluent Icons"
                                                                                   FontSize="9" />
                                                                    </Button>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <TextBlock Text="Nessuna app fissata. Aggiungine una per iniziare."
                                                           Style="{StaticResource T.Caption}" Margin="0,8,0,0"
                                                           Visibility="{Binding NoPinsVisibility}" />
                                                <TextBlock Text="{Binding PinStatus}" Style="{StaticResource T.Caption}"
                                                           Margin="0,8,0,0" Foreground="{DynamicResource C.Success}" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="CONTENUTO" Style="{StaticResource T.Section}" />
                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <StackPanel MaxWidth="500" HorizontalAlignment="Left">
                                                            <TextBlock Text="App fissate nella dock" FontSize="13"
                                                                       Foreground="{DynamicResource C.Text}" />
                                                            <TextBlock Text="Mostra le app che hai scelto di tenere sempre visibili."
                                                                       Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <CheckBox Style="{StaticResource Switch}"
                                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                  IsChecked="{Binding Settings.ShowPinned, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource Row}" BorderThickness="0" Padding="0" Margin="0">
                                                    <Grid>
                                                        <StackPanel MaxWidth="500" HorizontalAlignment="Left">
                                                            <TextBlock Text="App in esecuzione" FontSize="13"
                                                                       Foreground="{DynamicResource C.Text}" />
                                                            <TextBlock Text="Le finestre aperte compaiono accanto alle app fissate."
                                                                       Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <CheckBox Style="{StaticResource Switch}"
                                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                  IsChecked="{Binding Settings.ShowRunning, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- ICONE DI SISTEMA -->
                                <views:SystemIconsPage x:Name="PageSystemIcons" VerticalAlignment="Top"
                                                       Visibility="Collapsed"
                                                       DataContext="{Binding SystemIcons}" />

                                <!-- SCHEDE -->
                                <Grid x:Name="PageTabs" VerticalAlignment="Top" Visibility="Collapsed">
                                    <StackPanel>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                                            <StackPanel>
                                                <TextBlock Text="GRUPPI DI FINESTRE" Style="{StaticResource T.Section}" />

                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <StackPanel MaxWidth="500" HorizontalAlignment="Left">
                                                            <TextBlock Text="Attiva le schede" FontSize="13"
                                                                       Foreground="{DynamicResource C.Text}" />
                                                            <TextBlock Text="Raggruppa più finestre in una tab bar disegnata da Nebula."
                                                                       Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <CheckBox Style="{StaticResource Switch}"
                                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                  IsChecked="{Binding Settings.EnableTabs, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>

                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <StackPanel MaxWidth="500" HorizontalAlignment="Left">
                                                            <TextBlock Text="Crea un gruppo di schede" FontSize="13"
                                                                       Foreground="{DynamicResource C.Text}" />
                                                            <TextBlock Text="Scegli due o più finestre: le altre restano nascoste finché non selezioni la loro scheda."
                                                                       Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <Button Content="Scegli finestre…" Style="{StaticResource PrimaryButton}"
                                                                Padding="13,7" HorizontalAlignment="Right"
                                                                Click="OnCreateTabGroup" />
                                                    </Grid>
                                                </Border>

                                                <Border Style="{StaticResource Row}" BorderThickness="0" Padding="0" Margin="0">
                                                    <Grid>
                                                        <StackPanel MaxWidth="500" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding TabsSummary}" FontSize="13"
                                                                       Foreground="{DynamicResource C.Text}" />
                                                            <TextBlock Text="Chiudendo un gruppo tutte le finestre tornano nella posizione originale."
                                                                       Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <Button Content="Chiudi tutti i gruppi" Style="{StaticResource GhostButton}"
                                                                Padding="12,7" HorizontalAlignment="Right"
                                                                Click="OnCloseTabGroups" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                                            <StackPanel>
                                                <TextBlock Text="ASPETTO DELLA TAB BAR" Style="{StaticResource T.Section}" />

                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <StackPanel MaxWidth="500" HorizontalAlignment="Left">
                                                            <TextBlock Text="Stile" FontSize="13"
                                                                       Foreground="{DynamicResource C.Text}" />
                                                            <TextBlock Text="Vetro, minimal o neon: la tab bar segue il tema e l'accento."
                                                                       Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <ComboBox Width="190" Height="32"
                                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                  ItemsSource="{Binding TabStyleOptions}"
                                                                  SelectedValuePath="Id"
                                                                  SelectedValue="{Binding Settings.TabsStyle, Mode=TwoWay}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Name}" />
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </Grid>
                                                </Border>

                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="Altezza della barra" FontSize="13"
                                                                       Foreground="{DynamicResource C.Text}" />
                                                            <Slider Style="{StaticResource SlimSlider}" Minimum="34"
                                                                    Maximum="64" Value="{Binding Settings.TabsBarHeight, Mode=TwoWay}"
                                                                    Margin="0,8,24,0" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                                   Text="{Binding Settings.TabsBarHeight, StringFormat='{}{0:0} px'}"
                                                                   FontSize="12" Foreground="{DynamicResource C.TextMuted}" />
                                                    </Grid>
                                                </Border>

                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <StackPanel MaxWidth="500" HorizontalAlignment="Left">
                                                            <TextBlock Text="Posizione" FontSize="13"
                                                                       Foreground="{DynamicResource C.Text}" />
                                                            <TextBlock Text="La barra resta ancorata alla finestra attiva del gruppo."
                                                                       Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <ComboBox Width="190" Height="32"
                                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                  ItemsSource="{Binding TabPositionOptions}"
                                                                  SelectedValuePath="Id"
                                                                  SelectedValue="{Binding Settings.TabsBarPosition, Mode=TwoWay}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Name}" />
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </Grid>
                                                </Border>

                                                <TextBlock Text="Apertura, cambio scheda e chiusura seguono Animazioni fluide e la velocità impostata in Animazioni; con le animazioni ridotte la barra risponde subito."
                                                           Style="{StaticResource T.Caption}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="COME FUNZIONA" Style="{StaticResource T.Section}" />
                                                <TextBlock Text="La tab bar mostra titolo e icona reali di ogni finestra. Clicca una scheda per portarla davanti, trascinala per riordinarla, usa la × per chiuderla o il menu destro per staccarla. Se una finestra si chiude, la scheda sparisce da sola."
                                                           Style="{StaticResource T.Caption}" />
                                                <WrapPanel Margin="0,14,0,0">
                                                    <Border Style="{StaticResource Chip}">
                                                        <TextBlock Text="Ripristino geometria" FontSize="10.5"
                                                                   Foreground="{DynamicResource C.TextMuted}" />
                                                    </Border>
                                                    <Border Style="{StaticResource Chip}">
                                                        <TextBlock Text="Recupero dopo crash" FontSize="10.5"
                                                                   Foreground="{DynamicResource C.TextMuted}" />
                                                    </Border>
                                                    <Border Style="{StaticResource Chip}">
                                                        <TextBlock Text="Nessuna finestra nascosta" FontSize="10.5"
                                                                   Foreground="{DynamicResource C.TextMuted}" />
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- WIDGET -->
                                <Grid x:Name="PageWidget" VerticalAlignment="Top" Visibility="Collapsed">
                                    <StackPanel>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                                            <StackPanel>
                                                <TextBlock Text="OROLOGIO" Style="{StaticResource T.Section}" />
                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <TextBlock Text="Mostra orologio" FontSize="13"
                                                                   Foreground="{DynamicResource C.Text}" VerticalAlignment="Center" />
                                                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                                  VerticalAlignment="Center"
                                                                  IsChecked="{Binding Settings.ShowClock, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <TextBlock Text="Mostra data" FontSize="13"
                                                                   Foreground="{DynamicResource C.Text}" VerticalAlignment="Center" />
                                                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                                  VerticalAlignment="Center"
                                                                  IsChecked="{Binding Settings.ShowDate, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <TextBlock Text="Mostra secondi" FontSize="13"
                                                                   Foreground="{DynamicResource C.Text}" VerticalAlignment="Center" />
                                                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                                  VerticalAlignment="Center"
                                                                  IsChecked="{Binding Settings.ShowSeconds, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource Row}" BorderThickness="0" Padding="0" Margin="0">
                                                    <Grid>
                                                        <TextBlock Text="Formato 24 ore" FontSize="13"
                                                                   Foreground="{DynamicResource C.Text}" VerticalAlignment="Center" />
                                                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                                  VerticalAlignment="Center"
                                                                  IsChecked="{Binding Settings.Clock24Hour, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                                            <StackPanel>
                                                <TextBlock Text="LA TUA COLLEZIONE" Style="{StaticResource T.Section}" />
                                                <TextBlock Text="Scegli i widget da inserire nel pannello: si aggiornano in tempo reale e restano nell'ordine del catalogo. Puoi attivarli o disattivarli in qualsiasi momento."
                                                           Style="{StaticResource T.Caption}" Margin="0,0,0,10" TextWrapping="Wrap" />
                                                <ItemsControl ItemsSource="{Binding WidgetOptions}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="338" Margin="0,0,10,8"
                                                                    Background="{DynamicResource S.InnerBg}"
                                                                    BorderBrush="{DynamicResource S.InnerBorder}"
                                                                    BorderThickness="{DynamicResource S.BorderThickness}"
                                                                    CornerRadius="{DynamicResource S.ControlRadius}"
                                                                    Padding="10,8">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="28" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons"
                                                                               FontSize="15" Foreground="{DynamicResource C.AccentText}"
                                                                               VerticalAlignment="Center" />
                                                                    <StackPanel Grid.Column="1" Margin="6,0,8,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Name}" FontSize="11.5"
                                                                                   Foreground="{DynamicResource C.Text}" />
                                                                        <TextBlock Text="{Binding Description}" FontSize="9.5"
                                                                                   Foreground="{DynamicResource C.TextMuted}"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                    <CheckBox Grid.Column="2" Style="{StaticResource Switch}"
                                                                              VerticalAlignment="Center"
                                                                              AutomationProperties.Name="{Binding Name}"
                                                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding WidgetCountText}" Style="{StaticResource T.Caption}"
                                                           Margin="2,2,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                                            <StackPanel>
                                                <TextBlock Text="WIDGET E CONTROLLI" Style="{StaticResource T.Section}" />
                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <StackPanel MaxWidth="500" HorizontalAlignment="Left">
                                                            <TextBlock Text="Monitor sistema" FontSize="13"
                                                                       Foreground="{DynamicResource C.Text}" />
                                                            <TextBlock Text="CPU e RAM sempre sotto controllo, direttamente nella dock."
                                                                       Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                                  VerticalAlignment="Center"
                                                                  IsChecked="{Binding Settings.ShowStats, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <TextBlock Text="Batteria" FontSize="13"
                                                                   Foreground="{DynamicResource C.Text}" VerticalAlignment="Center" />
                                                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                                  VerticalAlignment="Center"
                                                                  IsChecked="{Binding Settings.ShowBattery, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <TextBlock Text="Pulsante pannello widget" FontSize="13"
                                                                   Foreground="{DynamicResource C.Text}" VerticalAlignment="Center" />
                                                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                                  VerticalAlignment="Center"
                                                                  AutomationProperties.Name="Mostra widget"
                                                                  IsChecked="{Binding Settings.ShowWidgets, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource Row}" BorderThickness="0" Padding="0" Margin="0">
                                                    <Grid>
                                                        <TextBlock Text="Pulsante impostazioni" FontSize="13"
                                                                   Foreground="{DynamicResource C.Text}" VerticalAlignment="Center" />
                                                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                                  VerticalAlignment="Center"
                                                                  IsChecked="{Binding Settings.ShowSettingsButton, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="PANNELLO WIDGET" Style="{StaticResource T.Section}" />
                                                <TextBlock Text="Orologio grande, calendario navigabile, anelli CPU/RAM, grafico in tempo reale e riepilogo del sistema."
                                                           Style="{StaticResource T.Caption}" Margin="0,0,0,12" />
                                                <Button Content="Apri pannello widget" Style="{StaticResource PrimaryButton}"
                                                        HorizontalAlignment="Left" Click="OnOpenWidgets" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- RICERCA -->
                                <Grid x:Name="PageSearch" VerticalAlignment="Top" Visibility="Collapsed">
                                    <StackPanel>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                                            <StackPanel>
                                                <TextBlock Text="MOTORE DI RICERCA" Style="{StaticResource T.Section}" />
                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <StackPanel MaxWidth="500" HorizontalAlignment="Left">
                                                            <TextBlock Text="Abilita la ricerca" FontSize="13"
                                                                       Foreground="{DynamicResource C.Text}" />
                                                            <TextBlock Text="Mostra il pulsante nella dock e abilita Ctrl+Alt+Spazio."
                                                                       Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                                  VerticalAlignment="Center"
                                                                  AutomationProperties.Name="Abilita ricerca"
                                                                  IsChecked="{Binding Settings.ShowSearch, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <StackPanel MaxWidth="500" HorizontalAlignment="Left">
                                                            <TextBlock Text="Cerca anche finestre aperte" FontSize="13"
                                                                       Foreground="{DynamicResource C.Text}" />
                                                            <TextBlock Text="I risultati includono i titoli delle finestre; Invio le porta in primo piano."
                                                                       Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                                  VerticalAlignment="Center"
                                                                  AutomationProperties.Name="Cerca finestre aperte"
                                                                  IsChecked="{Binding Settings.SearchIncludeWindows, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource Row}" BorderThickness="0" Padding="0" Margin="0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="Larghezza del pannello" FontSize="13"
                                                                       Foreground="{DynamicResource C.Text}" />
                                                            <TextBlock Text="Regola grafica applicata alla ricerca."
                                                                       Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                                                            <Slider Style="{StaticResource SlimSlider}" Minimum="560" Maximum="900"
                                                                    Value="{Binding Settings.SearchCardWidth, Mode=TwoWay}"
                                                                    AutomationProperties.Name="Larghezza ricerca"
                                                                    Margin="0,8,120,0" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                                   Text="{Binding Settings.SearchCardWidth, StringFormat='{}{0:0} px'}"
                                                                   FontSize="12" Foreground="{DynamicResource C.TextMuted}" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="APRI LA RICERCA" Style="{StaticResource T.Section}" />
                                                <TextBlock Text="Cerca app installate, finestre aperte e azioni di Nebula. Frecce per navigare, Invio per aprire, Esc per chiudere."
                                                           Style="{StaticResource T.Caption}" Margin="0,0,0,12" TextWrapping="Wrap" />
                                                <Button Content="Apri ricerca" Style="{StaticResource PrimaryButton}"
                                                        HorizontalAlignment="Left" Click="OnOpenSearch" />
                                                <TextBlock Text="Scorciatoia globale: Ctrl + Alt + Spazio"
                                                           Style="{StaticResource T.Caption}" Margin="0,10,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- CONTROLLI RAPIDI -->
                                <Grid x:Name="PageControls" VerticalAlignment="Top" Visibility="Collapsed">
                                    <StackPanel>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                                            <StackPanel>
                                                <TextBlock Text="SUPERFICIE CONTROLLI" Style="{StaticResource T.Section}" />
                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <StackPanel MaxWidth="500" HorizontalAlignment="Left">
                                                            <TextBlock Text="Mostra i controlli rapidi" FontSize="13"
                                                                       Foreground="{DynamicResource C.Text}" />
                                                            <TextBlock Text="Pulsante nella dock, volume, media, rete e luminosità in un pannello leggero."
                                                                       Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                                  VerticalAlignment="Center"
                                                                  AutomationProperties.Name="Mostra controlli rapidi"
                                                                  IsChecked="{Binding Settings.ShowQuickControls, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource Row}" BorderThickness="0" Padding="0" Margin="0">
                                                    <Grid>
                                                        <StackPanel MaxWidth="500" HorizontalAlignment="Left">
                                                            <TextBlock Text="Layout compatto" FontSize="13"
                                                                       Foreground="{DynamicResource C.Text}" />
                                                            <TextBlock Text="Riduce la larghezza del pannello e lascia più spazio al desktop."
                                                                       Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                                  VerticalAlignment="Center"
                                                                  AutomationProperties.Name="Layout compatto controlli"
                                                                  IsChecked="{Binding Settings.QuickControlsCompact, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="APRI I CONTROLLI" Style="{StaticResource T.Section}" />
                                                <TextBlock Text="Volume e mute usano l'endpoint audio di Windows; i tasti media agiscono sul player attivo. La rete apre le impostazioni di Windows; la luminosità dipende dal supporto DDC del monitor."
                                                           Style="{StaticResource T.Caption}" Margin="0,0,0,12" TextWrapping="Wrap" />
                                                <Button Content="Apri controlli rapidi" Style="{StaticResource PrimaryButton}"
                                                        HorizontalAlignment="Left" Click="OnOpenControls" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- ANIMAZIONI -->
                                <Grid x:Name="PageAnimations" VerticalAlignment="Top" Visibility="Collapsed">
                                    <StackPanel>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                                            <StackPanel>
                                                <TextBlock Text="MOVIMENTO" Style="{StaticResource T.Section}" />
                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <StackPanel MaxWidth="500" HorizontalAlignment="Left">
                                                            <TextBlock Text="Animazioni fluide" FontSize="13"
                                                                       Foreground="{DynamicResource C.Text}" />
                                                            <TextBlock Text="Transizioni, ingressi e micro-interazioni animate."
                                                                       Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                                  VerticalAlignment="Center"
                                                                  AutomationProperties.Name="Animazioni fluide"
                                                                  IsChecked="{Binding Settings.AnimationsEnabled, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="Velocità delle animazioni" FontSize="13"
                                                                       Foreground="{DynamicResource C.Text}" />
                                                            <Slider Style="{StaticResource SlimSlider}" Minimum="0.5"
                                                                    Maximum="2" Value="{Binding Settings.AnimationSpeed, Mode=TwoWay}"
                                                                    Margin="0,8,120,0" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                                   Text="{Binding Settings.AnimationSpeed, StringFormat='{}{0:0.00}×'}"
                                                                   FontSize="12" Foreground="{DynamicResource C.TextMuted}" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <StackPanel MaxWidth="500" HorizontalAlignment="Left">
                                                            <TextBlock Text="Ingrandimento al passaggio" FontSize="13"
                                                                       Foreground="{DynamicResource C.Text}" />
                                                            <TextBlock Text="Le icone crescono con una curva elastica sotto il cursore."
                                                                       Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                                  VerticalAlignment="Center"
                                                                  IsChecked="{Binding Settings.HoverMagnify, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource Row}" BorderThickness="0" Padding="0" Margin="0">
                                                    <Grid>
                                                        <StackPanel MaxWidth="500" HorizontalAlignment="Left">
                                                            <TextBlock Text="Pulsazione all'avvio" FontSize="13"
                                                                       Foreground="{DynamicResource C.Text}" />
                                                            <TextBlock Text="Un piccolo rimbalzo quando l'app parte dalla dock."
                                                                       Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                                  VerticalAlignment="Center"
                                                                  IsChecked="{Binding Settings.LaunchPulse, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="PRESTAZIONI" Style="{StaticResource T.Section}" />
                                                <TextBlock Text="Nebula anima solo transform e opacità, lavora a 60 fps e non tiene thread in polling continuo. Con le animazioni disattivate la dock risponde all'istante."
                                                           Style="{StaticResource T.Caption}" />
                                                <WrapPanel Margin="0,14,0,0">
                                                    <Border Style="{StaticResource Chip}">
                                                        <TextBlock Text="GPU accelerated" FontSize="10.5"
                                                                   Foreground="{DynamicResource C.TextMuted}" />
                                                    </Border>
                                                    <Border Style="{StaticResource Chip}">
                                                        <TextBlock Text="60 fps" FontSize="10.5"
                                                                   Foreground="{DynamicResource C.TextMuted}" />
                                                    </Border>
                                                    <Border Style="{StaticResource Chip}">
                                                        <TextBlock Text="Nessun polling pesante" FontSize="10.5"
                                                                   Foreground="{DynamicResource C.TextMuted}" />
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- COMPORTAMENTO -->
                                <Grid x:Name="PageBehavior" VerticalAlignment="Top" Visibility="Collapsed">
                                    <StackPanel>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                                            <StackPanel>
                                                <TextBlock Text="AVVIO" Style="{StaticResource T.Section}" />
                                                <Border Style="{StaticResource Row}" BorderThickness="0" Padding="0" Margin="0">
                                                    <Grid>
                                                        <StackPanel MaxWidth="500" HorizontalAlignment="Left">
                                                            <TextBlock Text="Avvia con Windows" FontSize="13"
                                                                       Foreground="{DynamicResource C.Text}" />
                                                            <TextBlock Text="Nebula parte con il sistema e la dock è pronta."
                                                                       Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                                  VerticalAlignment="Center"
                                                                  IsChecked="{Binding Settings.LaunchAtStartup, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <Grid Margin="0,0,0,20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                                                <StackPanel>
                                                    <TextBlock Text="SCORCIATOIE" Style="{StaticResource T.Section}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                                        <Border Background="{DynamicResource C.Hover}" CornerRadius="7"
                                                                Padding="8,4">
                                                            <TextBlock Text="{Binding HotkeyText}" FontSize="10.5"
                                                                       Foreground="{DynamicResource C.Text}" />
                                                        </Border>
                                                        <TextBlock Text="apri la ricerca" FontSize="11"
                                                                   VerticalAlignment="Center" Margin="9,0,0,0"
                                                                   Foreground="{DynamicResource C.TextMuted}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                        <Border Background="{DynamicResource C.Hover}" CornerRadius="7"
                                                                Padding="8,4">
                                                            <TextBlock Text="{Binding WidgetHotkeyText}" FontSize="10.5"
                                                                       Foreground="{DynamicResource C.Text}" />
                                                        </Border>
                                                        <TextBlock Text="pannello widget" FontSize="11"
                                                                   VerticalAlignment="Center" Margin="9,0,0,0"
                                                                   Foreground="{DynamicResource C.TextMuted}" />
                                                    </StackPanel>
                                                    <TextBlock Text="Le scorciatoie funzionano anche quando un'altra app è in primo piano."
                                                               Style="{StaticResource T.Caption}" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="ANCHE NEL MENU" Style="{StaticResource T.Section}" />
                                                    <TextBlock Text="Cerca, widget e dock restano sempre a portata di mano; da qui puoi ripristinare la taskbar di Windows in qualsiasi momento."
                                                               Style="{StaticResource T.Caption}" />
                                                    <Button Content="Ripristina taskbar di Windows"
                                                            Style="{StaticResource GhostButton}" Padding="12,7"
                                                            HorizontalAlignment="Left" Margin="0,12,0,0"
                                                            Click="OnRestoreTaskbar" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="DATI" Style="{StaticResource T.Section}" />
                                                <TextBlock Text="Tutte le impostazioni sono salvate in locale e applicate in tempo reale. Nessun dato lascia il PC."
                                                           Style="{StaticResource T.Caption}" Margin="0,0,0,12" />
                                                <TextBlock Text="{Binding SettingsPath}" FontSize="10.5"
                                                           Foreground="{DynamicResource C.TextFaint}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Button Content="Apri cartella impostazioni" Style="{StaticResource GhostButton}"
                                                        Padding="12,7" HorizontalAlignment="Left" Margin="0,12,0,0"
                                                        Click="OnOpenSettingsFolder" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- INFO -->
                                <Grid x:Name="PageInfo" VerticalAlignment="Top" Visibility="Collapsed">
                                    <StackPanel>
                                        <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,20">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="62" Height="62" CornerRadius="18"
                                                        Background="{DynamicResource C.AccentGrad}">
                                                    <UniformGrid Rows="2" Columns="2" Width="24" Height="24">
                                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource C.OnAccent}" Margin="2" />
                                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource C.OnAccent}" Margin="2" />
                                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource C.OnAccent}" Margin="2" />
                                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource C.OnAccent}" Margin="2" />
                                                    </UniformGrid>
                                                </Border>
                                                <StackPanel Margin="18,4,0,0">
                                                    <TextBlock Text="Nebula Taskbar Studio" Style="{StaticResource T.H1}"
                                                               FontSize="22" />
                                                    <TextBlock Text="Una taskbar che sembra tua: vetro, luce e movimento."
                                                               Style="{StaticResource T.Caption}" Margin="0,4,0,0" />
                                                    <WrapPanel Margin="0,12,0,0">
                                                        <Border Style="{StaticResource Chip}">
                                                            <TextBlock Text="WPF · .NET 8" FontSize="10.5"
                                                                       Foreground="{DynamicResource C.TextMuted}" />
                                                        </Border>
                                                        <Border Style="{StaticResource Chip}">
                                                            <TextBlock Text="Nativo e leggero" FontSize="10.5"
                                                                       Foreground="{DynamicResource C.TextMuted}" />
                                                        </Border>
                                                        <Border Style="{StaticResource Chip}">
                                                            <TextBlock Text="100% locale" FontSize="10.5"
                                                                       Foreground="{DynamicResource C.TextMuted}" />
                                                        </Border>
                                                        <Border Style="{StaticResource Chip}">
                                                            <TextBlock Text="Icone shell 64 px" FontSize="10.5"
                                                                       Foreground="{DynamicResource C.TextMuted}" />
                                                        </Border>
                                                        <Border Style="{StaticResource Chip}">
                                                            <TextBlock Text="{Binding Version, StringFormat='v{0}'}"
                                                                       FontSize="10.5"
                                                                       Foreground="{DynamicResource C.TextMuted}" />
                                                        </Border>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Grid Margin="0,0,0,20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                                                <StackPanel>
                                                    <TextBlock Text="COSA PUOI FARE" Style="{StaticResource T.Section}" />
                                                    <TextBlock Text="16 preset con anteprima dal vivo, 5 superfici, accento personalizzato, zone dock indipendenti e icone adattive."
                                                               Style="{StaticResource T.Caption}" Margin="0,0,0,8" />
                                                    <TextBlock Text="Ricerca globale delle app, widget con calendario e monitor, menu per ogni finestra."
                                                               Style="{StaticResource T.Caption}" Margin="0,0,0,8" />
                                                    <TextBlock Text="Auto-hide, nascondi in schermo intero, avvio con Windows, sostituzione reversibile della taskbar."
                                                               Style="{StaticResource T.Caption}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="COMANDI RAPIDI" Style="{StaticResource T.Section}" />
                                                    <TextBlock Text="Clic su un'icona: apri o riduci a icona."
                                                               Style="{StaticResource T.Caption}" Margin="0,0,0,6" />
                                                    <TextBlock Text="Clic destro: finestre, chiudi, fissa alla dock."
                                                               Style="{StaticResource T.Caption}" Margin="0,0,0,6" />
                                                    <TextBlock Text="Start / lente / Ctrl+Alt+Spazio: ricerca immediata."
                                                               Style="{StaticResource T.Caption}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                                            <StackPanel>
                                                <TextBlock Text="AGGIORNAMENTI" Style="{StaticResource T.Section}" />
                                                <TextBlock Text="Nebula controlla GitHub Releases all'avvio e ogni 15 minuti. Se è disponibile una versione nuova mostra il popup Aggiorna e riavvia: il download, la verifica SHA-256, l'installazione e il riavvio sono automatici. Il manifest predefinito punta all'ultima Release GitHub; puoi sovrascriverlo con un URL personalizzato."
                                                           Style="{StaticResource T.Caption}" Margin="0,0,0,10" TextWrapping="Wrap" />
                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                                                            <TextBlock Text="Aggiornamenti automatici" FontSize="13"
                                                                       Foreground="{DynamicResource C.Text}" />
                                                            <TextBlock Text="Controllo all'avvio e ogni 15 minuti; popup con Aggiorna e riavvio automatici quando viene pubblicata una nuova versione."
                                                                       Style="{StaticResource T.Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                                  VerticalAlignment="Center"
                                                                  AutomationProperties.Name="Aggiornamenti automatici"
                                                                  IsChecked="{Binding Settings.AutoUpdate, Mode=TwoWay}" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource Row}">
                                                    <Grid>
                                                        <TextBlock Text="Manifest aggiornamenti" FontSize="13" Foreground="{DynamicResource C.Text}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBox Style="{StaticResource Input}" Width="440" Height="32"
                                                                 HorizontalAlignment="Right"
                                                                 AutomationProperties.Name="Manifest aggiornamenti"
                                                                 AutomationProperties.AutomationId="UpdateManifestUrl"
                                                                 Text="{Binding Settings.UpdateManifestUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource Row}" BorderThickness="0" Padding="0" Margin="0">
                                                    <Grid>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding UpdateStatus}" FontSize="11.5"
                                                                       AutomationProperties.AutomationId="UpdateStatusText"
                                                                       Foreground="{DynamicResource C.Text}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding UpdateNotes}" FontSize="10.5"
                                                                       Foreground="{DynamicResource C.TextMuted}" Margin="0,3,0,0"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button Content="Verifica ora" Style="{StaticResource GhostButton}"
                                                                    Padding="12,7" Click="OnCheckUpdates" />
                                                            <Button Content="Scarica e installa" Style="{StaticResource PrimaryButton}"
                                                                    Padding="12,7" Margin="8,0,0,0"
                                                                    IsEnabled="{Binding UpdateAvailable}"
                                                                    Click="OnInstallUpdate" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource C.Stroke}">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="RIPRISTINO" Style="{StaticResource T.Section}" />
                                                    <TextBlock Text="Riporta Nebula allo stato iniziale: stile, dock, widget e app fissate."
                                                               Style="{StaticResource T.Caption}" />
                                                    <TextBlock Text="La taskbar di Windows viene ripristinata quando esci."
                                                               Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                    <Button Content="Ripristina tutto" Style="{StaticResource GhostButton}"
                                                            Padding="13,8" Click="OnResetAll" />
                                                    <Button Content="Esci da Nebula" Style="{StaticResource GhostButton}"
                                                            Padding="13,8" Margin="8,0,0,0" Click="OnExitApp" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
