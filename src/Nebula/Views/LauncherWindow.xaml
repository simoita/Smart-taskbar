<Window x:Class="Nebula.Views.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Nebula.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Nebula Search" WindowStyle="None" AllowsTransparency="False"
        Background="{DynamicResource C.Bg}"
        ShowInTaskbar="True" ResizeMode="NoResize" WindowStartupLocation="Manual"
        SizeToContent="Height"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{DynamicResource S.FontFamily}"
        PreviewKeyDown="OnPreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Border x:Name="Card" Width="720" Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                CornerRadius="{DynamicResource S.CardRadius}" Background="{DynamicResource S.CardBg}"
                BorderBrush="{DynamicResource S.CardBorder}"
                BorderThickness="{DynamicResource S.BorderThickness}"
                Padding="{DynamicResource S.CardPadding}"
                Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <TranslateTransform x:Name="CardDragShift" />
                    <ScaleTransform x:Name="CardScale" ScaleX="0.97" ScaleY="0.97" />
                </TransformGroup>
            </Border.RenderTransform>

            <StackPanel>
                <Grid x:Name="HeaderDragArea" Margin="4,2,4,14" Background="Transparent"
                      Cursor="SizeAll" ToolTip="Trascina per spostare la ricerca">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="{DynamicResource S.InnerRadius}"
                                Background="{DynamicResource C.AccentGrad}">
                            <UniformGrid Rows="2" Columns="2" Width="14" Height="14">
                                <Ellipse Width="4" Height="4" Fill="{DynamicResource C.OnAccent}" Margin="1.2" />
                                <Ellipse Width="4" Height="4" Fill="{DynamicResource C.OnAccent}" Margin="1.2" />
                                <Ellipse Width="4" Height="4" Fill="{DynamicResource C.OnAccent}" Margin="1.2" />
                                <Ellipse Width="4" Height="4" Fill="{DynamicResource C.OnAccent}" Margin="1.2" />
                            </UniformGrid>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Nebula" FontWeight="{DynamicResource S.TitleWeight}" FontSize="14"
                                       Foreground="{DynamicResource C.Text}" />
                            <TextBlock x:Name="CaptionText" Text="Cerca, calcola, comanda o chiedi — senza web" FontSize="10.5"
                                       Foreground="{DynamicResource C.TextMuted}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Width="28" Height="28"
                                Click="OnOpenStudio" ToolTip="Apri Studio"
                                AutomationProperties.Name="Apri Studio dalla ricerca">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                        </Button>
                        <Border Background="{DynamicResource C.Hover}" CornerRadius="{DynamicResource S.ControlRadius}"
                                Padding="7,3" Margin="6,0,0,0">
                            <TextBlock Text="ESC" FontSize="9.5" Foreground="{DynamicResource C.TextMuted}" />
                        </Border>
                        <views:CaptionButtons ShowMaximize="False" Margin="6,0,0,0" />
                    </StackPanel>
                </Grid>

                <Border CornerRadius="{DynamicResource S.InnerRadius}" Background="{DynamicResource S.InnerBg}"
                        BorderBrush="{DynamicResource S.InnerBorder}"
                        BorderThickness="{DynamicResource S.BorderThickness}" Padding="13,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="18"
                                   Foreground="{DynamicResource C.TextMuted}" VerticalAlignment="Center"
                                   Margin="2,0,10,0" />
                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchBox" Style="{StaticResource Input}" Background="Transparent"
                                     BorderThickness="0" Padding="0,10" FontSize="17"
                                     AutomationProperties.Name="Ricerca"
                                     TextChanged="OnSearchTextChanged" />
                            <TextBlock x:Name="Placeholder" Text="Cerca, calcola o chiedi qualcosa…"
                                       FontSize="17" Foreground="{DynamicResource C.TextFaint}"
                                       VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False" />
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="SmartCard" Visibility="Collapsed" Margin="0,10,0,0"
                        CornerRadius="{DynamicResource S.InnerRadius}"
                        Background="{DynamicResource S.InnerBg}"
                        BorderBrush="{DynamicResource C.Accent}" BorderThickness="1"
                        Padding="14,12" Cursor="Hand"
                        MouseLeftButtonUp="OnSmartCardClick"
                        ToolTip="Invio esegue un comando o copia una risposta">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="{DynamicResource S.InnerRadius}"
                                Background="{DynamicResource C.AccentGrad}" VerticalAlignment="Top">
                            <TextBlock x:Name="SmartGlyph" FontFamily="Segoe Fluent Icons" FontSize="15"
                                       Foreground="{DynamicResource C.OnAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,10,0">
                            <TextBlock x:Name="SmartTitle" FontSize="14" TextWrapping="Wrap"
                                       FontWeight="{DynamicResource S.TitleWeight}"
                                       Foreground="{DynamicResource C.Text}" />
                            <ScrollViewer MaxHeight="150" Margin="0,3,0,0"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="SmartDetail" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource C.TextMuted}" />
                            </ScrollViewer>
                        </StackPanel>
                        <TextBlock x:Name="SmartHint" Grid.Column="2" FontSize="9.5"
                                   Foreground="{DynamicResource C.TextFaint}"
                                   VerticalAlignment="Top" Margin="8,2,2,0" />
                    </Grid>
                </Border>

                <ListBox x:Name="ResultList" Background="Transparent" BorderThickness="0"
                         Margin="0,10,0,0" MaxHeight="330" Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemContainerStyle="{StaticResource ResultItem}"
                         MouseDoubleClick="OnResultDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="{DynamicResource S.InnerRadius}"
                                        Background="{DynamicResource C.Hover}">
                                    <Grid>
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons"
                                                   FontSize="14" Foreground="{DynamicResource C.TextMuted}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding Icon}" Width="22" Height="22"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13.5"
                                               Foreground="{DynamicResource C.Text}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="9.5"
                                               Foreground="{DynamicResource C.TextFaint}"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding Subtitle, Converter={StaticResource EmptyStringCollapsed}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="Invio" FontSize="9.5"
                                           Foreground="{DynamicResource C.TextFaint}" VerticalAlignment="Center"
                                           Margin="8,0,4,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyText" Text="Nessun risultato. Prova un'app, un calcolo come 15% di 240, un comando come «dock in alto» o una domanda."
                           Foreground="{DynamicResource C.TextMuted}" FontSize="12.5"
                           HorizontalAlignment="Center" Margin="0,26" Visibility="Collapsed" />

                <Grid Margin="6,12,6,0">
                    <TextBlock Text="↑ ↓  naviga      Invio  apri o esegui      Shift+Invio  cartella      Esc  chiudi" FontSize="10.5"
                               Foreground="{DynamicResource C.TextFaint}" />
                    <TextBlock x:Name="CountText" FontSize="10.5" HorizontalAlignment="Right"
                               Foreground="{DynamicResource C.TextFaint}" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
