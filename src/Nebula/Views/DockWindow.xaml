<Window x:Class="Nebula.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nebula Dock" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Grid x:Name="Root" Margin="26,22,26,26" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="DockSlide" Y="24" />
        </Grid.RenderTransform>

        <Border x:Name="Shell" CornerRadius="{Binding ShellRadius}" Background="#E60B0716"
                BorderBrush="{Binding StrokeBrush}" BorderThickness="1"
                MinHeight="{Binding Settings.DockHeight}"
                MouseRightButtonUp="OnDockBackgroundRightClick">

            <Grid>
                <Border CornerRadius="{Binding ShellRadius}" Background="{Binding Backdrop}"
                        Visibility="{Binding BackdropVisibility}" Opacity="0.55" />

                <Border CornerRadius="{Binding ShellRadius}" Background="{Binding TintBrush}" />

                <Border CornerRadius="{Binding ShellRadius}" IsHitTestVisible="False"
                        Visibility="{Binding Settings.ShowGlow, Converter={StaticResource BoolVis}}">
                    <Border.Background>
                        <RadialGradientBrush Center="0.14,0.35" GradientOrigin="0.14,0.35"
                                             RadiusX="0.45" RadiusY="1.25">
                            <GradientStop Color="{DynamicResource C.AccentColor}" Offset="0" />
                            <GradientStop Color="#008B5CF6" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                    <Border.Opacity>0.3</Border.Opacity>
                </Border>

                <Border CornerRadius="{Binding ShellRadius}" IsHitTestVisible="False"
                        Visibility="{Binding Settings.ShowGlow, Converter={StaticResource BoolVis}}">
                    <Border.Background>
                        <RadialGradientBrush Center="0.88,0.5" GradientOrigin="0.88,0.5"
                                             RadiusX="0.4" RadiusY="1.2">
                            <GradientStop Color="{DynamicResource C.Accent2Color}" Offset="0" />
                            <GradientStop Color="#0022D3EE" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                    <Border.Opacity>0.22</Border.Opacity>
                </Border>

                <Border CornerRadius="{Binding ShellRadius}" Background="{StaticResource GrainBrush}"
                        IsHitTestVisible="False"
                        Visibility="{Binding Settings.ShowGrain, Converter={StaticResource BoolVis}}" />

                <Border Height="1" VerticalAlignment="Top" Margin="20,0,20,0"
                        Background="#26FFFFFF" IsHitTestVisible="False" />

                <Border Height="1" VerticalAlignment="Bottom" Margin="26,0,26,0"
                        Background="{DynamicResource C.AccentGrad}" Opacity="0.28"
                        IsHitTestVisible="False"
                        Visibility="{Binding Settings.ShowShimmer, Converter={StaticResource BoolVis}}" />

                <StackPanel x:Name="ZoneHost" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <StackPanel x:Name="AppsZone" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StartButton" Width="{Binding ItemSize}" Height="{Binding ItemSize}"
                            Style="{StaticResource DockOrbButton}" Click="OnStartClick"
                            ToolTip="Cerca app e finestre  ·  Ctrl+Alt+Spazio">
                        <UniformGrid Rows="2" Columns="2" Width="15" Height="15">
                            <Ellipse Width="4.5" Height="4.5" Fill="{DynamicResource C.OnAccent}" Margin="1.3" />
                            <Ellipse Width="4.5" Height="4.5" Fill="{DynamicResource C.OnAccent}" Margin="1.3" />
                            <Ellipse Width="4.5" Height="4.5" Fill="{DynamicResource C.OnAccent}" Margin="1.3" />
                            <Ellipse Width="4.5" Height="4.5" Fill="{DynamicResource C.OnAccent}" Margin="1.3" />
                        </UniformGrid>
                    </Button>

                    <Border Width="1" Height="24" Margin="8,0,6,0" VerticalAlignment="Center"
                            Background="{DynamicResource C.StrokeSoft}" />

                    <ItemsControl x:Name="DockItems" ItemsSource="{Binding Items}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource DockAppButton}"
                                        Width="{Binding DataContext.ItemSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        Height="{Binding DataContext.ItemSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        Margin="{Binding DataContext.ItemMargin, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        Click="OnItemClick" MouseRightButtonUp="OnItemRightClick">
                                    <Grid>
                                        <Border x:Name="ActiveGlow" CornerRadius="11"
                                                Background="{DynamicResource C.AccentFaint}" Opacity="0" />
                                        <Border Margin="1"
                                                CornerRadius="{Binding IconPlateCornerRadius}"
                                                Background="{DynamicResource C.AccentSoft}"
                                                Opacity="{Binding IconPlateOpacity}"
                                                Visibility="{Binding IconPlateVisibility}" />
                                        <Border x:Name="IconShell"
                                                Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CornerRadius="{Binding IconCornerRadius}"
                                                Background="Transparent" Padding="0"
                                                Visibility="{Binding HasIcon, Converter={StaticResource BoolVis}}">
                                            <Image Source="{Binding DisplayIcon}"
                                                   Width="{Binding IconDisplaySize}"
                                                   Height="{Binding IconDisplaySize}"
                                                   Stretch="Uniform"
                                                   Clip="{Binding IconClip}"
                                                   Opacity="{Binding StateOpacity}"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <Border CornerRadius="11" Margin="1"
                                                Background="{DynamicResource C.AccentSoft}"
                                                Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolVis}}">
                                            <TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource C.Text}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <Border x:Name="OpenIndicator"
                                                Width="{Binding IndicatorWidth}" Height="{Binding IndicatorHeight}"
                                                CornerRadius="{Binding IndicatorRadius}"
                                                Background="{DynamicResource C.TextMuted}"
                                                Visibility="{Binding OpenIndicatorVisibility}"
                                                VerticalAlignment="Bottom" Margin="0,0,0,2" />
                                        <Border x:Name="MinimizedIndicator"
                                                Width="{Binding IndicatorWidth}" Height="{Binding IndicatorHeight}"
                                                CornerRadius="{Binding IndicatorRadius}"
                                                Background="{DynamicResource C.Warn}"
                                                Visibility="{Binding MinimizedIndicatorVisibility}"
                                                VerticalAlignment="Bottom" Margin="0,0,0,2" />
                                        <Border x:Name="ClosedIndicator"
                                                Width="{Binding IndicatorWidth}" Height="{Binding IndicatorHeight}"
                                                CornerRadius="{Binding IndicatorRadius}"
                                                Background="{DynamicResource C.TextFaint}"
                                                Opacity="0.55"
                                                Visibility="{Binding ClosedIndicatorVisibility}"
                                                VerticalAlignment="Bottom" Margin="0,0,0,2" />
                                    </Grid>
                                    <Button.ToolTip>
                                        <StackPanel MaxWidth="280">
                                            <TextBlock Text="{Binding TooltipTitle}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding TooltipSubtitle}" FontSize="11"
                                                       Foreground="{DynamicResource C.TextMuted}" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button.ToolTip>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IconStyle}" Value="tile">
                                        <Setter TargetName="IconShell" Property="Background" Value="{DynamicResource C.Hover}" />
                                        <Setter TargetName="IconShell" Property="Padding" Value="3" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IconStyle}" Value="circle">
                                        <Setter TargetName="IconShell" Property="Background" Value="{DynamicResource C.AccentSoft}" />
                                        <Setter TargetName="IconShell" Property="Padding" Value="3" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IconStyle}" Value="mono">
                                        <Setter TargetName="IconShell" Property="Background" Value="{DynamicResource C.Hover}" />
                                        <Setter TargetName="IconShell" Property="Padding" Value="3" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IconStyle}" Value="neon">
                                        <Setter TargetName="IconShell" Property="Background" Value="{DynamicResource C.AccentFaint}" />
                                        <Setter TargetName="IconShell" Property="BorderBrush" Value="{DynamicResource C.Accent}" />
                                        <Setter TargetName="IconShell" Property="BorderThickness" Value="1" />
                                        <Setter TargetName="IconShell" Property="Padding" Value="3" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="OpenIndicator" Property="Width" Value="20" />
                                        <Setter TargetName="OpenIndicator" Property="Background"
                                                Value="{DynamicResource C.Accent}" />
                                        <Setter TargetName="ActiveGlow" Property="Opacity" Value="0.9" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    </StackPanel>

                    <StackPanel x:Name="SystemZone" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Width="96" Margin="8,0,6,0" VerticalAlignment="Center"
                                    Visibility="{Binding Settings.ShowStats, Converter={StaticResource BoolVis}}">
                            <Grid>
                                <TextBlock Text="CPU" FontSize="8.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource C.TextMuted}" />
                                <TextBlock Text="{Binding Monitor.CpuText}" FontSize="8.5"
                                           HorizontalAlignment="Right" Foreground="{DynamicResource C.Text}" />
                            </Grid>
                            <ProgressBar Style="{StaticResource MiniBar}" Maximum="100"
                                         Value="{Binding Monitor.Cpu, Mode=OneWay}" Margin="0,3,0,6" />
                            <Grid>
                                <TextBlock Text="RAM" FontSize="8.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource C.TextMuted}" />
                                <TextBlock Text="{Binding Monitor.RamText}" FontSize="8.5"
                                           HorizontalAlignment="Right" Foreground="{DynamicResource C.Text}" />
                            </Grid>
                            <ProgressBar Style="{StaticResource MiniBar}" Maximum="100"
                                         Value="{Binding Monitor.Ram, Mode=OneWay}" Margin="0,3,0,0" />
                        </StackPanel>

                        <Border Width="1" Height="24" Margin="2,0,8,0" VerticalAlignment="Center"
                                Background="{DynamicResource C.StrokeSoft}"
                                Visibility="{Binding Settings.ShowStats, Converter={StaticResource BoolVis}}" />

                        <StackPanel Margin="0,0,10,0" VerticalAlignment="Center"
                                    Visibility="{Binding Settings.ShowBattery, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding Monitor.BatteryText}" FontSize="11.5" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource C.Text}" />
                            <TextBlock Text="BATTERIA" FontSize="7.5" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource C.TextMuted}" />
                        </StackPanel>

                        <StackPanel Margin="4,0,8,0" VerticalAlignment="Center"
                                    Visibility="{Binding Settings.ShowClock, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding TimeText}" FontSize="15.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource C.Text}"
                                       Typography.NumeralAlignment="Tabular" />
                            <TextBlock Text="{Binding DateText}" FontSize="10.5"
                                       Foreground="{DynamicResource C.TextMuted}"
                                       Visibility="{Binding Settings.ShowDate, Converter={StaticResource BoolVis}}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="ActionsZone" Orientation="Horizontal" VerticalAlignment="Center">

                        <Button Style="{StaticResource DockIconButton}" Click="OnTabsClick"
                                ToolTip="Raggruppa finestre in schede"
                                AutomationProperties.Name="Schede"
                                Visibility="{Binding Settings.EnableTabs, Converter={StaticResource BoolVis}}">
                            <Grid Width="16" Height="16">
                                <Border Width="11" Height="9" CornerRadius="3"
                                        BorderBrush="{DynamicResource C.TextMuted}" BorderThickness="1.3"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                <Border Width="11" Height="9" CornerRadius="3"
                                        Background="{DynamicResource C.TooltipBg}"
                                        BorderBrush="{DynamicResource C.Accent}" BorderThickness="1.3"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" />
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource DockIconButton}" Click="OnSearchClick"
                                ToolTip="Cerca app e finestre  ·  Ctrl+Alt+Spazio"
                                AutomationProperties.Name="Cerca"
                                Visibility="{Binding Settings.ShowSearch, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                        </Button>

                        <Button Style="{StaticResource DockIconButton}" Click="OnWidgetsClick"
                                ToolTip="Pannello widget  ·  Ctrl+Alt+W"
                                AutomationProperties.Name="Widget"
                                Visibility="{Binding Settings.ShowWidgets, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="&#xE71D;" FontFamily="Segoe Fluent Icons" FontSize="15" />
                        </Button>

                        <Button Style="{StaticResource DockIconButton}" Click="OnControlsClick"
                                ToolTip="Controlli rapidi"
                                AutomationProperties.Name="Controlli rapidi"
                                Visibility="{Binding Settings.ShowQuickControls, Converter={StaticResource BoolVis}}">
                            <Grid Width="16" Height="16">
                                <Border Width="13" Height="2" CornerRadius="1"
                                        Background="{DynamicResource C.TextMuted}"
                                        VerticalAlignment="Top" Margin="0,4,0,0" />
                                <Ellipse Width="5" Height="5" Fill="{DynamicResource C.Accent}"
                                         HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,2,0,0" />
                                <Border Width="13" Height="2" CornerRadius="1"
                                        Background="{DynamicResource C.TextMuted}"
                                        VerticalAlignment="Bottom" Margin="0,0,0,4" />
                                <Ellipse Width="5" Height="5" Fill="{DynamicResource C.Accent2}"
                                         HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,2" />
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource DockIconButton}" Click="OnSettingsClick"
                                ToolTip="Impostazioni Nebula"
                                AutomationProperties.Name="Impostazioni"
                                Visibility="{Binding Settings.ShowSettingsButton, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="15" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
