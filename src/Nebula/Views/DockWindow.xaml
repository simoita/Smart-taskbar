<Window x:Class="Nebula.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nebula Dock" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Grid x:Name="Root" Margin="26,22,26,26" Opacity="0">
        <Border x:Name="Shell" CornerRadius="{Binding ShellCornerRadius}"
                Background="{DynamicResource C.DockShell}"
                BorderBrush="{Binding StrokeBrush}" BorderThickness="1"
                MinHeight="{Binding Settings.DockHeight}"
                MouseMove="OnShellMouseMove" MouseLeave="OnShellMouseLeave"
                PreviewMouseDown="OnShellMouseDown"
                MouseRightButtonUp="OnDockBackgroundRightClick">

            <Grid ClipToBounds="False">
                <Grid x:Name="ShellChrome">
                <Border CornerRadius="{Binding ShellCornerRadius}" Background="{Binding Backdrop}"
                        Visibility="{Binding BackdropVisibility}" Opacity="0.55" />

                <Border CornerRadius="{Binding ShellCornerRadius}" Background="{Binding TintBrush}" />

                <Border CornerRadius="{Binding ShellCornerRadius}" IsHitTestVisible="False"
                        Visibility="{Binding ChromeGlowVisibility}">
                    <Border.Background>
                        <RadialGradientBrush Center="0.14,0.35" GradientOrigin="0.14,0.35"
                                             RadiusX="0.45" RadiusY="1.25">
                            <GradientStop Color="{DynamicResource C.AccentColor}" Offset="0" />
                            <GradientStop Color="#008B5CF6" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                    <Border.Opacity>0.3</Border.Opacity>
                </Border>

                <Border CornerRadius="{Binding ShellCornerRadius}" IsHitTestVisible="False"
                        Visibility="{Binding ChromeGlowVisibility}">
                    <Border.Background>
                        <RadialGradientBrush Center="0.88,0.5" GradientOrigin="0.88,0.5"
                                             RadiusX="0.4" RadiusY="1.2">
                            <GradientStop Color="{DynamicResource C.Accent2Color}" Offset="0" />
                            <GradientStop Color="#0022D3EE" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                    <Border.Opacity>0.22</Border.Opacity>
                </Border>

                <Border CornerRadius="{Binding ShellCornerRadius}" Background="{StaticResource GrainBrush}"
                        IsHitTestVisible="False"
                        Visibility="{Binding ChromeGrainVisibility}" />

                <!-- Bevel: a light line just inside the top stroke and a dark one
                     just above the bottom stroke. Both are rounded, so no line
                     stops in mid-air over a corner, and both are theme-aware: on
                     a light preset a white line used to disappear.
                     Sul bordo basso dello schermo le due linee inferiori
                     sparirebbero nella cornice del monitor, quindi si spengono. -->
                <Border CornerRadius="{Binding InnerRadius}" IsHitTestVisible="False"
                        BorderThickness="0,1,0,0" BorderBrush="{DynamicResource C.DockHighlight}" />

                <Grid Visibility="{Binding ChromeBottomLineVisibility}">
                    <Border CornerRadius="{Binding InnerRadius}" IsHitTestVisible="False"
                            BorderThickness="0,0,0,1" BorderBrush="{DynamicResource C.DockShade}" />

                    <Border CornerRadius="{Binding InnerRadius}" Margin="1" IsHitTestVisible="False"
                            BorderThickness="0,0,0,1" BorderBrush="{DynamicResource C.AccentGrad}" Opacity="0.16"
                            Visibility="{Binding ChromeShimmerVisibility}" />
                </Grid>

                <Border x:Name="LiquidSheen" Width="280" HorizontalAlignment="Left"
                        CornerRadius="{Binding ShellCornerRadius}"
                        IsHitTestVisible="False" Opacity="0.16"
                        Visibility="{Binding ChromeSheenVisibility}">
                    <Border.Background>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5"
                                             RadiusX="0.5" RadiusY="1.35">
                            <GradientStop Color="#66FFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="SheenShift" />
                    </Border.RenderTransform>
                </Border>

                <!-- Finiture semplici: un unico colore pieno, senza bagliori,
                     grana, riflessi o ombre. -->
                <Border x:Name="FlatFill" CornerRadius="{Binding ShellCornerRadius}"
                        Background="{Binding FlatFillBrush}" IsHitTestVisible="False"
                        Visibility="{Binding FlatFillVisibility}" />
                </Grid>

                <Grid x:Name="ZoneHost" VerticalAlignment="Center" Margin="{Binding ZoneHostMargin}">
                    <StackPanel x:Name="AppsZone" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StartButton" Width="{Binding ItemSize}" Height="{Binding ItemSize}"
                            Style="{StaticResource DockOrbButton}" Click="OnStartClick"
                            ToolTip="Start di Nebula  ·  tasto Windows">
                        <UniformGrid Rows="2" Columns="2"
                                     Width="{Binding StartGlyphSize}" Height="{Binding StartGlyphSize}">
                            <Border Margin="1" CornerRadius="2"
                                    Background="{DynamicResource C.AccentGrad}" />
                            <Border Margin="1" CornerRadius="2"
                                    Background="{DynamicResource C.AccentGrad}" />
                            <Border Margin="1" CornerRadius="2"
                                    Background="{DynamicResource C.AccentGrad}" />
                            <Border Margin="1" CornerRadius="2"
                                    Background="{DynamicResource C.AccentGrad}" />
                        </UniformGrid>
                    </Button>

                    <!-- Space the bar keeps for the dockbar when it is docked
                         inside the bar, right next to the Start button. Only the
                         bar on the capsule's own monitor shows it. -->
                    <Border x:Name="IslandSlot"
                            Width="{Binding IslandSlotWidth}"
                            Margin="{Binding IslandSlotMargin}"
                            Visibility="Collapsed"
                            Background="Transparent" />

                    <Border Width="1" Height="{Binding SeparatorHeight}"
                            Margin="{Binding SeparatorMargin}" VerticalAlignment="Center"
                            Background="{DynamicResource C.Separator}" />

                    <ItemsControl x:Name="DockItems" ItemsSource="{Binding Items}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource DockAppButton}"
                                        Width="{Binding DataContext.ItemSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        Height="{Binding DataContext.ItemSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        Margin="{Binding DataContext.ItemMargin, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        Click="OnItemClick" MouseRightButtonUp="OnItemRightClick"
                                        MouseEnter="OnDockItemEnter" MouseLeave="OnDockItemLeave"
                                        AllowDrop="True"
                                        PreviewMouseLeftButtonDown="OnItemDragStart"
                                        PreviewMouseMove="OnItemDragMove"
                                        DragOver="OnItemDragOver" DragLeave="OnItemDragLeave"
                                        Drop="OnItemDrop">
                                    <Grid>
                                        <!-- The indicator lane exists for every icon, running or
                                             not: an Auto row was removed only when an app was open
                                             and shifted that icon 1.5 px off the others. -->
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="{Binding DataContext.IndicatorLaneLength, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                        </Grid.RowDefinitions>
                                        <Border x:Name="ActiveGlow" Grid.RowSpan="2"
                                                CornerRadius="{Binding DataContext.ItemRadius, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Background="{DynamicResource C.AccentFaint}" Opacity="0" />
                                        <Border Grid.Row="0" Margin="1"
                                                CornerRadius="{Binding IconPlateCornerRadius}"
                                                Background="{DynamicResource C.AccentSoft}"
                                                Opacity="{Binding IconPlateOpacity}"
                                                Visibility="{Binding IconPlateVisibility}" />
                                        <Border x:Name="IconShell" Grid.Row="0"
                                                Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                CornerRadius="{Binding IconCornerRadius}"
                                                Background="Transparent" Padding="0"
                                                Visibility="{Binding HasIcon, Converter={StaticResource BoolVis}}">
                                            <Image Source="{Binding DisplayIcon}"
                                                   Width="{Binding IconDisplaySize}"
                                                   Height="{Binding IconDisplaySize}"
                                                   Stretch="Uniform"
                                                   Clip="{Binding IconClip}"
                                                   Opacity="{Binding StateOpacity}"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <Border Grid.Row="0" CornerRadius="{Binding IconCornerRadius}" Margin="1"
                                                Background="{DynamicResource C.AccentSoft}"
                                                Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolVis}}">
                                            <TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource C.Text}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <Border x:Name="OpenIndicator" Grid.Row="1"
                                                Width="{Binding IndicatorWidth}" Height="{Binding IndicatorHeight}"
                                                CornerRadius="{Binding IndicatorRadius}"
                                                Background="{DynamicResource C.TextMuted}"
                                                Visibility="{Binding OpenIndicatorVisibility}"
                                                VerticalAlignment="Center" Margin="0" />
                                        <Border x:Name="MinimizedIndicator" Grid.Row="1"
                                                Width="{Binding IndicatorWidth}" Height="{Binding IndicatorHeight}"
                                                CornerRadius="{Binding IndicatorRadius}"
                                                Background="{DynamicResource C.Warn}"
                                                Visibility="{Binding MinimizedIndicatorVisibility}"
                                                VerticalAlignment="Center" Margin="0" />
                                        <Border x:Name="ClosedIndicator" Grid.Row="1"
                                                Width="{Binding IndicatorWidth}" Height="{Binding IndicatorHeight}"
                                                CornerRadius="{Binding IndicatorRadius}"
                                                Background="{DynamicResource C.TextFaint}"
                                                Opacity="0.55"
                                                Visibility="{Binding ClosedIndicatorVisibility}"
                                                VerticalAlignment="Center" Margin="0" />
                                    </Grid>
                                    <Button.ToolTip>
                                        <StackPanel MaxWidth="280">
                                            <TextBlock Text="{Binding TooltipTitle}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding TooltipSubtitle}" FontSize="11"
                                                       Foreground="{DynamicResource C.TextMuted}" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button.ToolTip>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IconStyle}" Value="tile">
                                        <Setter TargetName="IconShell" Property="Background" Value="{DynamicResource C.Hover}" />
                                        <Setter TargetName="IconShell" Property="Padding" Value="3" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IconStyle}" Value="circle">
                                        <Setter TargetName="IconShell" Property="Background" Value="{DynamicResource C.AccentSoft}" />
                                        <Setter TargetName="IconShell" Property="Padding" Value="3" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IconStyle}" Value="mono">
                                        <Setter TargetName="IconShell" Property="Background" Value="{DynamicResource C.Hover}" />
                                        <Setter TargetName="IconShell" Property="Padding" Value="3" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IconStyle}" Value="neon">
                                        <Setter TargetName="IconShell" Property="Background" Value="{DynamicResource C.AccentFaint}" />
                                        <Setter TargetName="IconShell" Property="BorderBrush" Value="{DynamicResource C.Accent}" />
                                        <Setter TargetName="IconShell" Property="BorderThickness" Value="1" />
                                        <Setter TargetName="IconShell" Property="Padding" Value="3" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="OpenIndicator" Property="Width" Value="20" />
                                        <Setter TargetName="OpenIndicator" Property="Background"
                                                Value="{DynamicResource C.Accent}" />
                                        <Setter TargetName="ActiveGlow" Property="Opacity" Value="0.9" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    </StackPanel>

                    <StackPanel x:Name="SystemZone" Orientation="Horizontal" VerticalAlignment="Center">
                        <ScrollViewer x:Name="WidgetScroller"
                                      MinHeight="36"
                                      VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      HorizontalContentAlignment="Center"
                                      PanningMode="HorizontalOnly"
                                      PreviewMouseWheel="OnWidgetScrollerWheel"
                                      CanContentScroll="False" Focusable="False">
                        <ItemsControl x:Name="TaskbarWidgets" ItemsSource="{Binding TaskbarWidgetItems}"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource TaskbarWidgetButton}"
                                            Click="OnTaskbarWidgetClick"
                                            MouseEnter="OnTaskbarWidgetPointerEnter"
                                            MouseLeave="OnTaskbarWidgetPointerLeave"
                                            AllowDrop="True"
                                            PreviewMouseLeftButtonDown="OnTaskbarWidgetDragStart"
                                            PreviewMouseMove="OnTaskbarWidgetDragMove"
                                            DragOver="OnTaskbarWidgetDragOver"
                                            DragLeave="OnTaskbarWidgetDragLeave"
                                            Drop="OnTaskbarWidgetDrop"
                                            ToolTip="{Binding Tooltip}">
                                        <Grid x:Name="WidgetRoot" MinHeight="28" RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform>
                                                <ScaleTransform x:Name="WidgetGrow" ScaleX="1" ScaleY="1" />
                                            </Grid.RenderTransform>
                                            <Border x:Name="SeparatorPart" Width="1" Height="20"
                                                    Background="{DynamicResource C.StrokeSoft}"
                                                    Visibility="Collapsed" />

                                            <StackPanel x:Name="ClockPart" VerticalAlignment="Center"
                                                        Visibility="Collapsed">
                                                <TextBlock Text="{Binding PrimaryText}" FontSize="14.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource C.Text}"
                                                           Typography.NumeralAlignment="Tabular" />
                                                <TextBlock Text="{Binding SecondaryText}" FontSize="9.5"
                                                           Foreground="{DynamicResource C.TextMuted}"
                                                           Visibility="{Binding HasSecondaryText, Converter={StaticResource BoolVis}}" />
                                            </StackPanel>

                                            <StackPanel x:Name="MetricPart" Width="82"
                                                        VerticalAlignment="Center"
                                                        Visibility="Collapsed">
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons"
                                                                   FontSize="9"
                                                                   Foreground="{DynamicResource C.TextMuted}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Label}" FontSize="8.5"
                                                                   Margin="4,0,0,0"
                                                                   Foreground="{DynamicResource C.TextMuted}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding PrimaryText}" FontSize="8.5"
                                                               HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource C.Text}"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                                <ProgressBar Style="{StaticResource MiniBar}" Maximum="100"
                                                             Value="{Binding Value, Mode=OneWay}"
                                                             Margin="0,2,0,2" />
                                                <Grid Visibility="{Binding HasSecondBar, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="{Binding Label2}" FontSize="8.5"
                                                               Foreground="{DynamicResource C.TextMuted}" />
                                                    <TextBlock Text="{Binding Value2Text}" FontSize="8.5"
                                                               HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource C.Text}" />
                                                </Grid>
                                                <ProgressBar Style="{StaticResource MiniBar}" Maximum="100"
                                                             Value="{Binding Value2, Mode=OneWay}"
                                                             Margin="0,2,0,0"
                                                             Visibility="{Binding HasSecondBar, Converter={StaticResource BoolVis}}" />
                                            </StackPanel>

                                            <StackPanel x:Name="TextPart" Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Visibility="Collapsed">
                                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource C.TextMuted}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding PrimaryText}" FontSize="10.5"
                                                           Margin="5,0,0,0"
                                                           Foreground="{DynamicResource C.Text}"
                                                           VerticalAlignment="Center" MaxWidth="110"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <StackPanel x:Name="MediaPart" Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Visibility="Collapsed">
                                                <Border Width="24" Height="24" CornerRadius="12"
                                                        Background="{DynamicResource C.AccentSoft}">
                                                    <TextBlock Text="{Binding MediaGlyph}"
                                                               FontFamily="Segoe Fluent Icons" FontSize="11"
                                                               Foreground="{DynamicResource C.AccentText}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Margin="8,0,2,0" VerticalAlignment="Center"
                                                            Visibility="{Binding MediaTextVisibility}">
                                                    <TextBlock Text="{Binding MediaTitle}" FontSize="10.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource C.Text}"
                                                               MaxWidth="190" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding MediaArtist}" FontSize="8.5"
                                                               Foreground="{DynamicResource C.TextMuted}"
                                                               MaxWidth="190" TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding HasMediaArtist, Converter={StaticResource BoolVis}}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock x:Name="IconPart" Text="{Binding Glyph}"
                                                       FontFamily="Segoe Fluent Icons" FontSize="13.5"
                                                       Foreground="{DynamicResource C.TextMuted}"
                                                       VerticalAlignment="Center"
                                                       Visibility="Collapsed" />
                                        </Grid>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding KindKey}" Value="Clock">
                                            <Setter TargetName="ClockPart" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding KindKey}" Value="Metric">
                                            <Setter TargetName="MetricPart" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding KindKey}" Value="Text">
                                            <Setter TargetName="TextPart" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding KindKey}" Value="Icon">
                                            <Setter TargetName="IconPart" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding KindKey}" Value="Media">
                                            <Setter TargetName="MediaPart" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding KindKey}" Value="Separator">
                                            <Setter TargetName="SeparatorPart" Property="Visibility" Value="Visible" />
                                        </DataTrigger>

                                        <!-- Icon-only mode keeps just the glyph; the
                                             separator remains a line. -->
                                        <DataTrigger Binding="{Binding IsIconMode}" Value="True">
                                            <Setter TargetName="ClockPart" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="MetricPart" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="TextPart" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="MediaPart" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="IconPart" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding KindKey}" Value="Separator">
                                            <Setter TargetName="IconPart" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="SeparatorPart" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <StackPanel x:Name="ActionsZone" Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Pulsanti scelti in Studio: ogni voce del catalogo
                             apre un pannello Nebula, una funzione di Windows o
                             un widget, senza aggiungere altre zone alla barra. -->
                        <ItemsControl x:Name="DockButtonsList" ItemsSource="{Binding DockButtons}"
                                      VerticalAlignment="Center"
                                      Visibility="{Binding DockButtonsVisibility}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource DockIconButton}"
                                            Width="{Binding DataContext.ActionButtonSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            Height="{Binding DataContext.ActionButtonSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            Click="OnDockButtonClick"
                                            ToolTip="{Binding Description}"
                                            AutomationProperties.Name="{Binding Name}">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons"
                                                   FontSize="14" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Style="{StaticResource DockIconButton}" Click="OnTabsClick"
                                Width="{Binding ActionButtonSize}" Height="{Binding ActionButtonSize}"
                                ToolTip="Raggruppa finestre in schede"
                                AutomationProperties.Name="Schede"
                                Visibility="{Binding Settings.EnableTabs, Converter={StaticResource BoolVis}}">
                            <Grid Width="16" Height="16">
                                <Border Width="11" Height="9" CornerRadius="3"
                                        BorderBrush="{DynamicResource C.TextMuted}" BorderThickness="1.3"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                <Border Width="11" Height="9" CornerRadius="3"
                                        Background="{DynamicResource C.TooltipBg}"
                                        BorderBrush="{DynamicResource C.Accent}" BorderThickness="1.3"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" />
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource DockIconButton}" Click="OnSearchClick"
                                Width="{Binding ActionButtonSize}" Height="{Binding ActionButtonSize}"
                                ToolTip="Cerca app e finestre  ·  Ctrl+Alt+Spazio"
                                AutomationProperties.Name="Cerca"
                                Visibility="{Binding Settings.ShowSearch, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                        </Button>

                        <Button Style="{StaticResource DockIconButton}" Click="OnWidgetsClick"
                                Width="{Binding ActionButtonSize}" Height="{Binding ActionButtonSize}"
                                ToolTip="Pannello widget  ·  Ctrl+Alt+W"
                                AutomationProperties.Name="Widget"
                                Visibility="{Binding Settings.ShowWidgets, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="&#xE71D;" FontFamily="Segoe Fluent Icons" FontSize="15" />
                        </Button>

                        <Button Style="{StaticResource DockIconButton}" Click="OnControlsClick"
                                Width="{Binding ActionButtonSize}" Height="{Binding ActionButtonSize}"
                                ToolTip="Controlli rapidi"
                                AutomationProperties.Name="Controlli rapidi"
                                Visibility="{Binding Settings.ShowQuickControls, Converter={StaticResource BoolVis}}">
                            <Grid Width="16" Height="16">
                                <Border Width="13" Height="2" CornerRadius="1"
                                        Background="{DynamicResource C.TextMuted}"
                                        VerticalAlignment="Top" Margin="0,4,0,0" />
                                <Ellipse Width="5" Height="5" Fill="{DynamicResource C.Accent}"
                                         HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,2,0,0" />
                                <Border Width="13" Height="2" CornerRadius="1"
                                        Background="{DynamicResource C.TextMuted}"
                                        VerticalAlignment="Bottom" Margin="0,0,0,4" />
                                <Ellipse Width="5" Height="5" Fill="{DynamicResource C.Accent2}"
                                         HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,2" />
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource DockIconButton}" Click="OnSettingsClick"
                                Width="{Binding ActionButtonSize}" Height="{Binding ActionButtonSize}"
                                ToolTip="Impostazioni Nebula"
                                AutomationProperties.Name="Impostazioni"
                                Visibility="{Binding Settings.ShowSettingsButton, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="15" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
