<Window x:Class="Nebula.Views.UpdateFailureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nebula · Aggiornamento non riuscito"
        Width="520" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Border Background="{DynamicResource C.Bg}"
            BorderBrush="{DynamicResource C.Stroke}"
            BorderThickness="1" CornerRadius="18" Margin="18">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Aggiornamento non riuscito"
                           Style="{StaticResource T.H1}" FontSize="23" />
                <TextBlock x:Name="VersionText"
                           Style="{StaticResource T.Caption}" Margin="0,5,0,0" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,12" Margin="0,18,0,0"
                    Background="{DynamicResource C.Hover}">
                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="DetailText"
                               Style="{StaticResource T.Caption}" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>

            <TextBlock Grid.Row="2"
                       Text="Nebula non è stata modificata. I dettagli tecnici sono in %LOCALAPPDATA%\Nebula\updates\apply-update.log."
                       Style="{StaticResource T.Caption}" Margin="0,14,0,0"
                       TextWrapping="Wrap" />

            <Button Grid.Row="3" Content="OK"
                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                    Padding="18,8" Margin="0,18,0,0" Click="OnCloseClick" />
        </Grid>
    </Border>
</Window>
