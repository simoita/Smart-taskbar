<Window x:Class="Nebula.Views.StartPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nebula Start" WindowStyle="SingleBorderWindow" AllowsTransparency="False"
        Background="{DynamicResource C.Bg}"
        ShowInTaskbar="True" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <DataTemplate x:Key="StartTileTemplate">
            <Button Style="{StaticResource DockAppButton}" Width="94" Height="92"
                    Margin="2,2" Tag="{Binding Path}" Click="OnTileClick"
                    ContextMenu="{Binding Menu}"
                    ToolTip="{Binding Name}">
                <Border x:Name="TileRoot" CornerRadius="14" Background="{DynamicResource C.Card}"
                        BorderBrush="{DynamicResource C.StrokeSoft}" BorderThickness="1"
                        Padding="8,9" Margin="3">
                    <StackPanel>
                        <Grid Width="40" Height="40" HorizontalAlignment="Center">
                            <Border CornerRadius="11" Background="{DynamicResource C.Hover}" />
                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons"
                                       FontSize="20" Foreground="{DynamicResource C.AccentText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Icon}" Width="30" Height="30"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding Name}" FontSize="10.5" Margin="0,7,0,0"
                                   Foreground="{DynamicResource C.Text}" TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Button>
            <DataTemplate.Triggers>
                <Trigger SourceName="TileRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="TileRoot" Property="Background" Value="{DynamicResource C.CardHover}" />
                    <Setter TargetName="TileRoot" Property="BorderBrush" Value="{DynamicResource C.Accent}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Border x:Name="Panel" Width="790" Height="640" HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="24" Background="#F4120F1C"
                BorderBrush="{DynamicResource C.DockStroke}" BorderThickness="1"
                Opacity="0" RenderTransformOrigin="0.5,1">
            <Border.RenderTransform>
                <TransformGroup>
                    <TranslateTransform x:Name="PanelDragShift" />
                    <TranslateTransform x:Name="PanelShift" Y="34" />
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="44" ShadowDepth="16" Direction="270"
                                  Opacity="0.6" Color="#000000" RenderingBias="Performance" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="HeaderDragArea" Margin="24,20,18,4" Background="Transparent"
                      Cursor="SizeAll" ToolTip="Trascina per spostare il pannello">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="12"
                                Background="{DynamicResource C.AccentGrad}">
                            <UniformGrid Rows="2" Columns="2" Width="14" Height="14">
                                <Ellipse Width="4" Height="4" Fill="{DynamicResource C.OnAccent}" Margin="1.2" />
                                <Ellipse Width="4" Height="4" Fill="{DynamicResource C.OnAccent}" Margin="1.2" />
                                <Ellipse Width="4" Height="4" Fill="{DynamicResource C.OnAccent}" Margin="1.2" />
                                <Ellipse Width="4" Height="4" Fill="{DynamicResource C.OnAccent}" Margin="1.2" />
                            </UniformGrid>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TimeText}" FontSize="19" FontWeight="SemiBold"
                                       Foreground="{DynamicResource C.Text}"
                                       Typography.NumeralAlignment="Tabular" />
                            <TextBlock Text="{Binding DateText}" FontSize="10.5"
                                       Foreground="{DynamicResource C.TextMuted}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Width="30" Height="30"
                                ToolTip="Apri Studio" Click="OnOpenSettings">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="30" Height="30"
                                ToolTip="Chiudi" Click="OnCloseClick">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Margin="24,10,18,0" VerticalAlignment="Bottom"
                        Background="{DynamicResource S.InnerBg}"
                        BorderBrush="{DynamicResource C.Stroke}"
                        BorderThickness="1" CornerRadius="13" Padding="12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="16"
                                   Foreground="{DynamicResource C.TextMuted}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchBox" Style="{StaticResource Input}"
                                     Background="Transparent" BorderThickness="0"
                                     Padding="0,11" FontSize="15"
                                     TextChanged="OnSearchChanged"
                                     AutomationProperties.Name="Cerca app, file e impostazioni" />
                            <TextBlock x:Name="SearchPlaceholder"
                                       Text="Cerca app, file, impostazioni o azioni…"
                                       FontSize="15" Foreground="{DynamicResource C.TextFaint}"
                                       VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="24,14,14,0">
                    <ScrollViewer x:Name="HomeView" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="FISSATE" Style="{StaticResource T.Section}" Margin="4,0,0,7" />
                            <ItemsControl x:Name="PinnedItems">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <TextBlock Text="CONSIGLIATI" Style="{StaticResource T.Section}"
                                       Margin="4,14,0,7" />
                            <ItemsControl x:Name="RecentItems">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <TextBlock Text="STRUMENTI RAPIDI" Style="{StaticResource T.Section}"
                                       Margin="4,14,0,7" />
                            <WrapPanel>
                                <Button Style="{StaticResource GhostButton}" Padding="13,9" Margin="0,0,8,8"
                                        Content="Tutte le app" Click="OnOpenAllApps" />
                                <Button Style="{StaticResource GhostButton}" Padding="13,9" Margin="0,0,8,8"
                                        Content="Pannello widget" Click="OnOpenWidgets" />
                                <Button Style="{StaticResource GhostButton}" Padding="13,9" Margin="0,0,8,8"
                                        Content="Controlli rapidi" Click="OnOpenControls" />
                                <Button Style="{StaticResource GhostButton}" Padding="13,9" Margin="0,0,8,8"
                                        Content="Raggruppa schede" Click="OnOpenTabs" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="ResultsView" Visibility="Collapsed">
                        <ListBox x:Name="ResultList" Background="Transparent" BorderThickness="0"
                                 MaxHeight="470" Focusable="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ItemContainerStyle="{StaticResource ResultItem}"
                                 MouseDoubleClick="OnResultDoubleClick"
                                 MouseRightButtonUp="OnResultRightClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="9"
                                                Background="{DynamicResource C.Hover}">
                                            <Grid>
                                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons"
                                                           FontSize="14" Foreground="{DynamicResource C.TextMuted}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Image Source="{Binding Icon}" Width="22" Height="22"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13"
                                                       Foreground="{DynamicResource C.Text}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="9.5"
                                                       Foreground="{DynamicResource C.TextFaint}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding Subtitle, Converter={StaticResource EmptyStringCollapsed}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="Invio" FontSize="9.5"
                                                   Foreground="{DynamicResource C.TextFaint}"
                                                   VerticalAlignment="Center" Margin="8,0,4,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="EmptyText" Text="Nessun risultato."
                                   Foreground="{DynamicResource C.TextMuted}" FontSize="12.5"
                                   HorizontalAlignment="Center" Margin="0,40"
                                   Visibility="Collapsed" />
                    </Grid>
                </Grid>

                <Border Grid.Row="3" Margin="24,12,18,18" Padding="12,9"
                        Background="{DynamicResource S.InnerBg}"
                        BorderBrush="{DynamicResource C.StrokeSoft}"
                        BorderThickness="1" CornerRadius="13">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="30" Height="30" CornerRadius="9"
                                    Background="{DynamicResource C.AccentSoft}">
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons"
                                           FontSize="13" Foreground="{DynamicResource C.AccentText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="UserText" FontSize="12" Margin="9,0,0,0"
                                       Foreground="{DynamicResource C.Text}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButton}" Padding="12,7"
                                    Content="Tutte le app" Click="OnOpenAllApps" />
                            <Button Style="{StaticResource IconButton}" Width="32" Height="30"
                                    Margin="8,0,0,0" ToolTip="Blocca il computer"
                                    AutomationProperties.Name="Blocca" Click="OnLockPc">
                                <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Width="32" Height="30"
                                    ToolTip="Sospendi" AutomationProperties.Name="Sospendi"
                                    Click="OnSleepPc">
                                <TextBlock Text="&#xE708;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Width="32" Height="30"
                                    ToolTip="Riavvia il PC" AutomationProperties.Name="Riavvia"
                                    Click="OnRestartPc">
                                <TextBlock Text="&#xE777;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Width="32" Height="30"
                                    ToolTip="Spegni il PC" AutomationProperties.Name="Spegni"
                                    Click="OnShutdownPc">
                                <TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Width="34" Height="30"
                                    Margin="4,0,0,0" ToolTip="Altre opzioni di alimentazione, inclusa l'uscita da Nebula"
                                    Click="OnPowerClick">
                                <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="10" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
